<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
	<name>Dharma Shop — Фильтр товаров</name>
	<author>Dharma</author>
	<creationDate>2026-10</creationDate>
	<copyright>(C) 2026 Dharma</copyright>
	<license>GNU General Public License version 2 or later</license>
	<version>0.1.19</version>
	<description>MOD_DHARMASHOP_FILTER_XML_DESCRIPTION</description>
	<namespace path="src">Dharma\Module\DharmaShopFilter</namespace>
	<files>
		<folder module="mod_dharmashop_filter">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
		<folder>layouts</folder>
	</files>
	<media folder="media" destination="mod_dharmashop_filter">
		<folder>js</folder>
		<folder>css</folder>
		<filename>joomla.asset.json</filename>
	</media>
	<languages>
		<language tag="ru-RU">language/ru-RU/mod_dharmashop_filter.ini</language>
		<language tag="ru-RU">language/ru-RU/mod_dharmashop_filter.sys.ini</language>
		<language tag="en-GB">language/en-GB/mod_dharmashop_filter.ini</language>
		<language tag="en-GB">language/en-GB/mod_dharmashop_filter.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic" label="MOD_DHARMASHOP_FILTER_TAB_BASIC" addfieldprefix="Dharma\Module\DharmaShopFilter\Site\Field">
				<field name="category_mode" type="list" default="current" filter="cmd" validate="options" label="MOD_DHARMASHOP_FILTER_CATEGORY_MODE" description="MOD_DHARMASHOP_FILTER_CATEGORY_MODE_DESC">
					<option value="current">MOD_DHARMASHOP_FILTER_CATEGORY_CURRENT</option>
					<option value="root">MOD_DHARMASHOP_FILTER_CATEGORY_ROOT</option>
					<option value="fixed">MOD_DHARMASHOP_FILTER_CATEGORY_FIXED</option>
				</field>
				<field name="category" type="category" extension="com_dharmashop" default="" filter="integer" showon="category_mode:fixed" label="MOD_DHARMASHOP_FILTER_CATEGORY" />
				<field name="menu_item" type="menuitem" published="1" filter="integer" label="MOD_DHARMASHOP_FILTER_MENU_ITEM" description="MOD_DHARMASHOP_FILTER_MENU_ITEM_DESC">
					<option value="0">MOD_DHARMASHOP_FILTER_MENU_ITEM_CURRENT</option>
				</field>
				<field name="orientation" type="list" default="vertical" filter="cmd" validate="options" label="MOD_DHARMASHOP_FILTER_ORIENTATION" description="MOD_DHARMASHOP_FILTER_ORIENTATION_DESC">
					<option value="vertical">MOD_DHARMASHOP_FILTER_ORIENTATION_VERTICAL</option>
					<option value="horizontal">MOD_DHARMASHOP_FILTER_ORIENTATION_HORIZONTAL</option>
				</field>
                <field name="horizontal_groups" type="list" default="dropdown" filter="cmd" validate="options" label="MOD_DHARMASHOP_FILTER_HORIZONTAL_GROUPS" showon="orientation:horizontal"><option value="dropdown">MOD_DHARMASHOP_FILTER_HORIZONTAL_DROPDOWN</option><option value="grid">MOD_DHARMASHOP_FILTER_HORIZONTAL_GRID</option></field>
                <field name="price_open" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="MOD_DHARMASHOP_FILTER_PRICE_OPEN" description="MOD_DHARMASHOP_FILTER_PRICE_OPEN_DESC" showon="orientation:horizontal[AND]horizontal_groups:dropdown"><option value="0">JNO</option><option value="1">JYES</option></field>
                <field name="bar_collapse" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="MOD_DHARMASHOP_FILTER_BAR_COLLAPSE" description="MOD_DHARMASHOP_FILTER_BAR_COLLAPSE_DESC" showon="orientation:horizontal"><option value="0">JNO</option><option value="1">JYES</option></field>
                <field name="sticky_mode" type="list" default="off" filter="cmd" validate="options" label="MOD_DHARMASHOP_FILTER_STICKY_MODE" description="MOD_DHARMASHOP_FILTER_STICKY_DESC" showon="orientation:vertical"><option value="off">JNO</option><option value="desktop">MOD_DHARMASHOP_FILTER_STICKY_DESKTOP</option><option value="always">MOD_DHARMASHOP_FILTER_STICKY_ALWAYS</option></field>
                <field name="sticky_offset" type="number" default="16" min="0" max="300" filter="integer" label="MOD_DHARMASHOP_FILTER_STICKY_OFFSET" showon="orientation:vertical[AND]sticky_mode:desktop,always" />
				<field name="ajax" type="radio" layout="joomla.form.field.radio.switcher" default="0" filter="integer" label="MOD_DHARMASHOP_FILTER_AJAX" description="MOD_DHARMASHOP_FILTER_AJAX_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="apply_mode" type="list" default="button" filter="cmd" validate="options" label="MOD_DHARMASHOP_FILTER_APPLY_MODE" description="MOD_DHARMASHOP_FILTER_APPLY_MODE_DESC">
					<option value="button">MOD_DHARMASHOP_FILTER_APPLY_MODE_BUTTON</option>
					<option value="instant">MOD_DHARMASHOP_FILTER_APPLY_MODE_INSTANT</option>
				</field>
				<field name="instant_delay" type="number" default="700" min="200" max="3000" step="100" filter="integer" showon="apply_mode:instant" label="MOD_DHARMASHOP_FILTER_INSTANT_DELAY" description="MOD_DHARMASHOP_FILTER_INSTANT_DELAY_DESC" />
				<field name="show_apply_button" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="MOD_DHARMASHOP_FILTER_SHOW_APPLY">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="apply_text" type="text" filter="string" showon="show_apply_button:1" label="MOD_DHARMASHOP_FILTER_APPLY_TEXT" description="MOD_DHARMASHOP_FILTER_APPLY_TEXT_DESC" hint="MOD_DHARMASHOP_FILTER_APPLY_TEXT_HINT" />
				<field name="show_reset_button" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="MOD_DHARMASHOP_FILTER_SHOW_RESET">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="show_active_chips" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="MOD_DHARMASHOP_FILTER_SHOW_CHIPS" description="MOD_DHARMASHOP_FILTER_SHOW_CHIPS_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="module_styles" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="MOD_DHARMASHOP_FILTER_MODULE_STYLES" description="MOD_DHARMASHOP_FILTER_MODULE_STYLES_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="heading" type="text" filter="string" label="MOD_DHARMASHOP_FILTER_HEADING" description="MOD_DHARMASHOP_FILTER_HEADING_DESC" />
				<field name="show_result_count" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="MOD_DHARMASHOP_FILTER_SHOW_COUNT" description="MOD_DHARMASHOP_FILTER_SHOW_COUNT_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
			<fieldset name="behavior" label="MOD_DHARMASHOP_FILTER_TAB_BEHAVIOR">
                <field name="cascade" type="list" default="inherit" filter="cmd" validate="options" label="MOD_DHARMASHOP_FILTER_CASCADE" description="MOD_DHARMASHOP_FILTER_CASCADE_DESC">
                    <option value="inherit">MOD_DHARMASHOP_FILTER_COUNTS_INHERIT</option><option value="on">JYES</option><option value="off">JNO</option>
                </field>
				<field name="empty_options" type="list" default="hide" filter="cmd" validate="options" label="MOD_DHARMASHOP_FILTER_EMPTY_OPTIONS" description="MOD_DHARMASHOP_FILTER_EMPTY_OPTIONS_DESC">
					<option value="show">MOD_DHARMASHOP_FILTER_EMPTY_SHOW</option>
					<option value="hide">MOD_DHARMASHOP_FILTER_EMPTY_HIDE</option>
					<option value="disable">MOD_DHARMASHOP_FILTER_EMPTY_DISABLE</option>
				</field>
                <field name="filtered_listing" type="list" default="inherit" filter="cmd" validate="options" label="MOD_DHARMASHOP_FILTER_FILTERED_LISTING" description="MOD_DHARMASHOP_FILTER_FILTERED_LISTING_DESC">
                    <option value="inherit">MOD_DHARMASHOP_FILTER_LISTING_INHERIT</option><option value="groups">MOD_DHARMASHOP_FILTER_LISTING_GROUPS</option><option value="products">MOD_DHARMASHOP_FILTER_LISTING_PRODUCTS</option>
                </field>
				<field name="counts" type="list" default="inherit" filter="cmd" validate="options" label="MOD_DHARMASHOP_FILTER_COUNTS" description="MOD_DHARMASHOP_FILTER_COUNTS_DESC">
					<option value="inherit">MOD_DHARMASHOP_FILTER_COUNTS_INHERIT</option>
					<option value="off">MOD_DHARMASHOP_FILTER_COUNTS_OFF</option>
					<option value="base">MOD_DHARMASHOP_FILTER_COUNTS_BASE</option>
					<option value="live">MOD_DHARMASHOP_FILTER_COUNTS_LIVE</option>
				</field>
				<field name="hide_single_value_fields" type="radio" layout="joomla.form.field.radio.switcher" default="0" filter="integer" label="MOD_DHARMASHOP_FILTER_HIDE_SINGLE" description="MOD_DHARMASHOP_FILTER_HIDE_SINGLE_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="collapsible_groups" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="MOD_DHARMASHOP_FILTER_COLLAPSIBLE" description="MOD_DHARMASHOP_FILTER_COLLAPSIBLE_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
			<fieldset name="values" label="MOD_DHARMASHOP_FILTER_TAB_VALUES">
				<field name="range_slider" type="radio" layout="joomla.form.field.radio.switcher" default="0" filter="integer" label="MOD_DHARMASHOP_FILTER_RANGE_SLIDER" description="MOD_DHARMASHOP_FILTER_RANGE_SLIDER_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="checkbox_limit_mode" type="list" default="all" filter="cmd" validate="options" label="MOD_DHARMASHOP_FILTER_LIMIT_MODE" description="MOD_DHARMASHOP_FILTER_LIMIT_MODE_DESC">
					<option value="all">MOD_DHARMASHOP_FILTER_LIMIT_ALL</option>
					<option value="limit">MOD_DHARMASHOP_FILTER_LIMIT_LIMIT</option>
				</field>
				<field name="checkbox_visible_count" type="number" default="6" min="1" max="100" filter="integer" showon="checkbox_limit_mode:limit" label="MOD_DHARMASHOP_FILTER_VISIBLE_COUNT" />
				<field name="options_sort" type="list" default="field" filter="cmd" validate="options" label="MOD_DHARMASHOP_FILTER_OPTIONS_SORT" description="MOD_DHARMASHOP_FILTER_OPTIONS_SORT_DESC">
					<option value="field">MOD_DHARMASHOP_FILTER_SORT_FIELD</option>
					<option value="alpha">MOD_DHARMASHOP_FILTER_SORT_ALPHA</option>
					<option value="count">MOD_DHARMASHOP_FILTER_SORT_COUNT</option>
				</field>
			</fieldset>
			<fieldset name="mobile" label="MOD_DHARMASHOP_FILTER_TAB_MOBILE">
				<field name="offcanvas_mode" type="list" default="never" filter="cmd" validate="options" label="MOD_DHARMASHOP_FILTER_OFFCANVAS_MODE" description="MOD_DHARMASHOP_FILTER_OFFCANVAS_MODE_DESC">
					<option value="never">MOD_DHARMASHOP_FILTER_OFFCANVAS_NEVER</option>
					<option value="mobile">MOD_DHARMASHOP_FILTER_OFFCANVAS_MOBILE</option>
					<option value="always">MOD_DHARMASHOP_FILTER_OFFCANVAS_ALWAYS</option>
				</field>
				<field name="offcanvas_breakpoint" type="list" default="lg" filter="cmd" validate="options" showon="offcanvas_mode:mobile" label="MOD_DHARMASHOP_FILTER_OFFCANVAS_BREAKPOINT" description="MOD_DHARMASHOP_FILTER_OFFCANVAS_BREAKPOINT_DESC">
					<option value="sm">MOD_DHARMASHOP_FILTER_BP_SM</option>
					<option value="md">MOD_DHARMASHOP_FILTER_BP_MD</option>
					<option value="lg">MOD_DHARMASHOP_FILTER_BP_LG</option>
					<option value="xl">MOD_DHARMASHOP_FILTER_BP_XL</option>
				</field>
				<field name="offcanvas_position" type="list" default="start" filter="cmd" validate="options" showon="offcanvas_mode:mobile,always" label="MOD_DHARMASHOP_FILTER_OFFCANVAS_POSITION">
					<option value="start">MOD_DHARMASHOP_FILTER_POSITION_START</option>
					<option value="end">MOD_DHARMASHOP_FILTER_POSITION_END</option>
				</field>
				<field name="offcanvas_inline" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" showon="offcanvas_mode:mobile,always" label="MOD_DHARMASHOP_FILTER_OFFCANVAS_INLINE" description="MOD_DHARMASHOP_FILTER_OFFCANVAS_INLINE_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="offcanvas_button_text" type="text" filter="string" showon="offcanvas_mode:mobile,always" label="MOD_DHARMASHOP_FILTER_OFFCANVAS_BUTTON_TEXT" hint="MOD_DHARMASHOP_FILTER_OFFCANVAS_BUTTON_HINT" />
				<field name="offcanvas_show_text" type="text" filter="string" showon="offcanvas_mode:mobile,always" label="MOD_DHARMASHOP_FILTER_OFFCANVAS_SHOW_TEXT" description="MOD_DHARMASHOP_FILTER_OFFCANVAS_SHOW_TEXT_DESC" hint="MOD_DHARMASHOP_FILTER_OFFCANVAS_SHOW_HINT" />
			</fieldset>
			<fieldset name="price" label="MOD_DHARMASHOP_FILTER_TAB_PRICE">
				<field name="price_display" type="list" default="inputs" filter="cmd" validate="options" label="MOD_DHARMASHOP_FILTER_PRICE_DISPLAY" description="MOD_DHARMASHOP_FILTER_PRICE_DISPLAY_DESC">
					<option value="none">MOD_DHARMASHOP_FILTER_PRICE_NONE</option>
					<option value="inputs">MOD_DHARMASHOP_FILTER_PRICE_INPUTS</option>
					<option value="slider">MOD_DHARMASHOP_FILTER_PRICE_SLIDER</option>
				</field>
				<field name="price_step" type="number" default="0" min="0" step="1" filter="integer" showon="price_display:inputs,slider" label="MOD_DHARMASHOP_FILTER_PRICE_STEP" description="MOD_DHARMASHOP_FILTER_PRICE_STEP_DESC" />
				<field name="price_presets" type="textarea" rows="4" filter="string" showon="price_display:inputs,slider" label="MOD_DHARMASHOP_FILTER_PRICE_PRESETS" description="MOD_DHARMASHOP_FILTER_PRICE_PRESETS_DESC" hint="MOD_DHARMASHOP_FILTER_PRICE_PRESETS_HINT" />
                <field name="price_presets_help" type="note" class="alert alert-info" showon="price_display:inputs,slider" label="MOD_DHARMASHOP_FILTER_PRICE_PRESETS_HELP" description="MOD_DHARMASHOP_FILTER_PRICE_PRESETS_EXAMPLES" />
			</fieldset>
			<fieldset name="filters" label="MOD_DHARMASHOP_FILTER_TAB_FILTERS" addfieldprefix="Dharma\Module\DharmaShopFilter\Site\Field">
				<field name="fields_note" type="note" class="alert alert-info" label="MOD_DHARMASHOP_FILTER_FIELDS_NOTE" description="MOD_DHARMASHOP_FILTER_FIELDS_NOTE_DESC" />
				<field name="fill_filters" type="fillfilters" filter="unset" hiddenLabel="true" />
                <field name="fields_config" type="subform" multiple="true" min="0" max="60" buttons="add,remove,move" layout="joomla.form.field.subform.repeatable-table" label="MOD_DHARMASHOP_FILTER_FIELDS_CONFIG" description="MOD_DHARMASHOP_FILTER_FIELDS_CONFIG_DESC">
					<form>
						<field name="field" type="filterfields" filter="string" required="true" label="MOD_DHARMASHOP_FILTER_FIELD" />
						<field name="show" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="MOD_DHARMASHOP_FILTER_FIELD_SHOW">
							<option value="0">JNO</option>
							<option value="1">JYES</option>
						</field>
						<field name="title" type="text" filter="string" label="MOD_DHARMASHOP_FILTER_FIELD_TITLE" />
						<field name="control" type="list" default="auto" filter="cmd" validate="options" label="MOD_DHARMASHOP_FILTER_FIELD_CONTROL">
							<option value="auto">MOD_DHARMASHOP_FILTER_CONTROL_AUTO</option>
							<option value="select">MOD_DHARMASHOP_FILTER_CONTROL_SELECT</option>
							<option value="checkboxes">MOD_DHARMASHOP_FILTER_CONTROL_CHECKBOXES</option>
							<option value="radio">MOD_DHARMASHOP_FILTER_CONTROL_RADIO</option>
							<option value="buttons">MOD_DHARMASHOP_FILTER_CONTROL_BUTTONS</option>
							<option value="swatches">MOD_DHARMASHOP_FILTER_CONTROL_SWATCHES</option><option value="images">MOD_DHARMASHOP_FILTER_CONTROL_IMAGES</option>
						</field>
						<field name="expanded" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="MOD_DHARMASHOP_FILTER_FIELD_EXPANDED">
							<option value="0">JNO</option>
							<option value="1">JYES</option>
						</field>
						<field name="logic" type="list" default="inherit" filter="cmd" validate="options" label="MOD_DHARMASHOP_FILTER_FIELD_LOGIC">
							<option value="inherit">MOD_DHARMASHOP_FILTER_LOGIC_INHERIT</option>
							<option value="or">MOD_DHARMASHOP_FILTER_LOGIC_OR</option>
							<option value="and">MOD_DHARMASHOP_FILTER_LOGIC_AND</option>
						</field>
					</form>
				</field>
			</fieldset>
			<fieldset name="advanced">
				<field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" class="form-select" validate="moduleLayout" />
				<field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="3" validate="CssIdentifier" />
				<field name="cache" type="list" default="0" label="COM_MODULES_FIELD_CACHING_LABEL" description="COM_MODULES_FIELD_CACHING_DESC">
					<option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
