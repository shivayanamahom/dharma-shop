<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
	<name>MOD_DHARMASHOP_CART</name>
	<author>Dharma</author>
	<creationDate>2026-10</creationDate>
	<copyright>(C) 2026 Dharma</copyright>
	<license>GNU General Public License version 2 or later</license>
	<version>0.1.0</version>
	<description>MOD_DHARMASHOP_CART_XML_DESCRIPTION</description>
	<namespace path="src">Dharma\Module\DharmaShopCart</namespace>
	<files>
		<folder module="mod_dharmashop_cart">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<languages>
		<language tag="ru-RU">language/ru-RU/mod_dharmashop_cart.ini</language>
		<language tag="ru-RU">language/ru-RU/mod_dharmashop_cart.sys.ini</language>
		<language tag="en-GB">language/en-GB/mod_dharmashop_cart.ini</language>
		<language tag="en-GB">language/en-GB/mod_dharmashop_cart.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="show_total" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="MOD_DHARMASHOP_CART_SHOW_TOTAL" description="MOD_DHARMASHOP_CART_SHOW_TOTAL_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="click_action" type="list" default="link" validate="options" label="MOD_DHARMASHOP_CART_CLICK" description="MOD_DHARMASHOP_CART_CLICK_DESC">
					<option value="link">MOD_DHARMASHOP_CART_CLICK_LINK</option>
					<option value="offcanvas">MOD_DHARMASHOP_CART_CLICK_OFFCANVAS</option>
				</field>
				<field name="open_on_add" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="MOD_DHARMASHOP_CART_OPEN_ON_ADD" description="MOD_DHARMASHOP_CART_OPEN_ON_ADD_DESC" showon="click_action:offcanvas">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="hide_empty_badge" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="MOD_DHARMASHOP_CART_HIDE_EMPTY" description="MOD_DHARMASHOP_CART_HIDE_EMPTY_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
			<fieldset name="advanced">
				<field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" class="form-select" validate="moduleLayout" />
				<field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="3" validate="CssIdentifier" />
			</fieldset>
		</fields>
	</config>
</extension>
