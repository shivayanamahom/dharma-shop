<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
	<name>Dharma Shop — Избранное</name>
	<author>Dharma</author>
	<creationDate>2026-10</creationDate>
	<copyright>(C) 2026 Dharma</copyright>
	<license>GNU General Public License version 2 or later</license>
	<version>0.1.14</version>
	<description>MOD_DHARMASHOP_FAVORITES_XML_DESCRIPTION</description>
	<namespace path="src">Dharma\Module\DharmaShopFavorites</namespace>
	<files>
		<folder module="mod_dharmashop_favorites">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<languages>
		<language tag="ru-RU">language/ru-RU/mod_dharmashop_favorites.ini</language>
		<language tag="ru-RU">language/ru-RU/mod_dharmashop_favorites.sys.ini</language>
		<language tag="en-GB">language/en-GB/mod_dharmashop_favorites.ini</language>
		<language tag="en-GB">language/en-GB/mod_dharmashop_favorites.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="hide_empty_badge" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="MOD_DHARMASHOP_FAVORITES_HIDE_EMPTY">
					<option value="0">JNO</option><option value="1">JYES</option>
				</field>
			</fieldset>
			<fieldset name="advanced">
				<field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" class="form-select" validate="moduleLayout" />
				<field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="3" validate="CssIdentifier" />
			</fieldset>
		</fields>
	</config>
</extension>
