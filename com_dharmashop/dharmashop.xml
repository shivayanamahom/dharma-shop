<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="6.0" method="upgrade">
	<name>COM_DHARMASHOP</name>
	<creationDate>2026-10</creationDate>
	<author>Dharma</author>
	<copyright>(C) 2026 Dharma. Все права защищены.</copyright>
	<license>GNU General Public License версии 2 или новее; см. LICENSE.txt</license>
	<version>0.1.3</version>
	<description>COM_DHARMASHOP_XML_DESCRIPTION</description>
	<namespace path="src">Dharma\Component\DharmaShop</namespace>

	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>

	<media destination="com_dharmashop" folder="media">
		<filename>joomla.asset.json</filename>
		<folder>css</folder>
		<folder>js</folder>
	</media>
	<files folder="site">
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>

	<languages folder="site">
		<language tag="ru-RU">language/ru-RU/com_dharmashop.ini</language>
		<language tag="en-GB">language/en-GB/com_dharmashop.ini</language>
	</languages>

	<administration>
		<menu>COM_DHARMASHOP</menu>
		<submenu>
			<menu link="option=com_dharmashop&amp;view=orders" view="orders">COM_DHARMASHOP_MENU_ORDERS</menu>
			<menu link="option=com_dharmashop&amp;view=carts" view="carts">COM_DHARMASHOP_MENU_CARTS</menu>
			<menu link="option=com_dharmashop&amp;view=favorites" view="favorites">COM_DHARMASHOP_MENU_FAVORITES</menu>
			<menu link="option=com_dharmashop&amp;view=customers" view="customers">COM_DHARMASHOP_MENU_CUSTOMERS</menu>
			<menu link="option=com_dharmashop&amp;view=statuses" view="statuses">COM_DHARMASHOP_MENU_STATUSES</menu>
			<menu link="option=com_dharmashop&amp;view=shippings" view="shippings">COM_DHARMASHOP_MENU_SHIPPING</menu>
			<menu link="option=com_dharmashop&amp;view=payments" view="payments">COM_DHARMASHOP_MENU_PAYMENT</menu>
			<menu link="option=com_dharmashop&amp;view=warehouses" view="warehouses">COM_DHARMASHOP_MENU_WAREHOUSES</menu>
			<menu link="option=com_dharmashop&amp;view=products" view="products">COM_DHARMASHOP_MENU_PRODUCTS</menu>
			<menu link="option=com_dharmashop&amp;view=productgroups" view="productgroups">COM_DHARMASHOP_MENU_PRODUCTGROUPS</menu>
			<menu link="option=com_dharmashop&amp;view=categories&amp;extension=com_dharmashop">COM_DHARMASHOP_MENU_CATEGORIES</menu>
			<menu link="option=com_dharmashop&amp;view=categories&amp;extension=com_dharmashop.brand">COM_DHARMASHOP_MENU_BRANDS</menu>
			<menu link="option=com_dharmashop&amp;view=categories&amp;extension=com_dharmashop.badge">COM_DHARMASHOP_MENU_BADGES</menu>
			<menu link="option=com_dharmashop&amp;view=fields" view="fields">COM_DHARMASHOP_MENU_FIELDS</menu>
			<menu link="option=com_dharmashop&amp;view=fieldgroups" view="fieldgroups">COM_DHARMASHOP_MENU_FIELDGROUPS</menu>
			<menu link="option=com_config&amp;view=component&amp;component=com_dharmashop">COM_DHARMASHOP_MENU_SETTINGS</menu>
			<menu link="option=com_dharmashop&amp;view=help" view="help">COM_DHARMASHOP_MENU_HELP</menu>
		</submenu>
		<files folder="admin">
			<filename>access.xml</filename>
			<filename>config.xml</filename>
			<folder>forms</folder>
			<folder>help</folder>
			<folder>language</folder>
			<folder>layouts</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
		</files>
		<languages folder="admin">
			<language tag="en-GB">language/en-GB/com_dharmashop.ini</language>
			<language tag="en-GB">language/en-GB/com_dharmashop.sys.ini</language>
			<language tag="ru-RU">language/ru-RU/com_dharmashop.ini</language>
			<language tag="ru-RU">language/ru-RU/com_dharmashop.sys.ini</language>
		</languages>
	</administration>
	<updateservers><server type="extension" priority="1" name="Dharma Shop: com_dharmashop">https://shivayanamahom.github.io/dharma-shop-updates/updates/com_dharmashop.xml</server></updateservers>
