<?xml version="1.0" encoding="utf-8"?>
<config>
	<!-- Разделы настроек магазина (вкладки): Магазин, Каталог, Изображения, SEO, Оформление заказа, Права. Новые разделы добавляются сюда fieldset-ом. -->
	<fieldset name="shop" label="COM_DHARMASHOP_CONFIG_SHOP" description="COM_DHARMASHOP_CONFIG_SHOP_DESC">
		<field name="currency_code" type="text" label="COM_DHARMASHOP_CONFIG_CURRENCY_CODE" description="COM_DHARMASHOP_CONFIG_CURRENCY_CODE_DESC" default="RUB" maxlength="3" filter="string" />
		<field name="currency_symbol" type="text" label="COM_DHARMASHOP_CONFIG_CURRENCY_SYMBOL" default="₽" maxlength="8" filter="string" />
		<field name="currency_position" type="list" label="COM_DHARMASHOP_CONFIG_CURRENCY_POSITION" default="after" validate="options">
			<option value="before">COM_DHARMASHOP_CONFIG_CURRENCY_BEFORE</option>
			<option value="after">COM_DHARMASHOP_CONFIG_CURRENCY_AFTER</option>
		</field>
		<field name="currency_decimals" type="integer" label="COM_DHARMASHOP_CONFIG_CURRENCY_DECIMALS" default="0" first="0" last="4" step="1" />
	</fieldset>

	<fieldset name="catalog" label="COM_DHARMASHOP_CONFIG_CATALOG" description="COM_DHARMASHOP_CONFIG_CATALOG_DESC">
		<field name="list_limit" type="integer" label="COM_DHARMASHOP_CONFIG_LIST_LIMIT" description="COM_DHARMASHOP_CONFIG_LIST_LIMIT_DESC" default="24" first="6" last="96" step="6" />
		<field name="list_ordering" type="list" label="COM_DHARMASHOP_CONFIG_LIST_ORDERING" description="COM_DHARMASHOP_CONFIG_LIST_ORDERING_DESC" default="order" validate="options">
			<option value="order">COM_DHARMASHOP_CAT_ORDERING_ORDER</option>
			<option value="price_asc">COM_DHARMASHOP_CAT_ORDERING_PRICE_ASC</option>
			<option value="price_desc">COM_DHARMASHOP_CAT_ORDERING_PRICE_DESC</option>
			<option value="new">COM_DHARMASHOP_CAT_ORDERING_NEW</option>
			<option value="title">COM_DHARMASHOP_CAT_ORDERING_TITLE</option>
		</field>
		<field name="new_product_position" type="list" label="COM_DHARMASHOP_CONFIG_NEW_PRODUCT_POSITION" description="COM_DHARMASHOP_CONFIG_NEW_PRODUCT_POSITION_DESC" default="last" validate="options">
			<option value="first">COM_DHARMASHOP_ORDER_FIRST</option>
			<option value="last">COM_DHARMASHOP_ORDER_LAST</option>
		</field>
	</fieldset>

