            <field name="categories_columns" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS" validate="options" default="3" showon="categories_breakpoints:0" description="COM_DHARMASHOP_DISPLAY_COLUMNS_DESC"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
