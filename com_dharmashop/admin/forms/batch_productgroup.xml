            <field name="value" type="category" label="COM_DHARMASHOP_BATCH_VALUE_CATEGORY" extension="com_dharmashop"><option value="">COM_DHARMASHOP_BATCH_CHOOSE</option></field>
        </fieldset></fields>
        <fields name="extra_categories"><fieldset name="extra_categories" label="COM_DHARMASHOP_BATCH_BLOCK_EXTRA" description="COM_DHARMASHOP_BATCH_GROUP_EXTRA_DESC">
