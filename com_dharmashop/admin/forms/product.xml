<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset name="basic" addfieldprefix="Joomla\Component\Categories\Administrator\Field">
		<field name="id" type="number" label="JGLOBAL_FIELD_ID_LABEL" default="0" class="readonly" readonly="true" />
		<field name="asset_id" type="hidden" filter="unset" />
		<field name="title" type="text" label="JGLOBAL_TITLE" required="true" maxlength="255" class="input-xxlarge input-large-text" size="40" />
		<field name="alias" type="text" label="JFIELD_ALIAS_LABEL" description="JFIELD_ALIAS_DESC" maxlength="190" hint="JFIELD_ALIAS_PLACEHOLDER" />
		<field name="catid" type="categoryedit" label="COM_DHARMASHOP_FIELD_CATEGORY_LABEL" description="COM_DHARMASHOP_FIELD_CATEGORY_DESC" extension="com_dharmashop" required="true" addfieldprefix="Joomla\Component\Categories\Administrator\Field" default="" />
		<field name="extra_catids" type="category" label="COM_DHARMASHOP_FIELD_EXTRA_CATEGORIES_LABEL" description="COM_DHARMASHOP_FIELD_EXTRA_CATEGORIES_DESC" extension="com_dharmashop" multiple="true" layout="joomla.form.field.list-fancy-select" />
		<field name="brand_id" type="category" label="COM_DHARMASHOP_FIELD_BRAND_LABEL" description="COM_DHARMASHOP_FIELD_BRAND_DESC" extension="com_dharmashop.brand">
			<option value="">COM_DHARMASHOP_FIELD_BRAND_NONE</option>
		</field>
		<field name="badge_ids" type="category" label="COM_DHARMASHOP_FIELD_BADGES_LABEL" description="COM_DHARMASHOP_FIELD_BADGES_DESC" extension="com_dharmashop.badge" multiple="true" layout="joomla.form.field.list-fancy-select" />
		<field name="state" type="list" label="JSTATUS" default="1" id="state" class="form-select-color-state" validate="options">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="2">JARCHIVED</option>
			<option value="-2">JTRASHED</option>
		</field>
		<field name="introtext" type="editor" label="COM_DHARMASHOP_FIELD_INTROTEXT_LABEL" description="COM_DHARMASHOP_FIELD_INTROTEXT_DESC" buttons="true" filter="\Joomla\CMS\Component\ComponentHelper::filterText" />
		<field name="fulltext" type="editor" label="COM_DHARMASHOP_FIELD_FULLTEXT_LABEL" buttons="true" filter="\Joomla\CMS\Component\ComponentHelper::filterText" />
		<field name="search_text" type="textarea" label="COM_DHARMASHOP_FIELD_SEARCH_TEXT_LABEL" description="COM_DHARMASHOP_FIELD_SEARCH_TEXT_DESC" rows="6" filter="string" />
	</fieldset>

    <fieldset name="product_group" label="COM_DHARMASHOP_PRODUCT_GROUP" addfieldprefix="Dharma\Component\DharmaShop\Administrator\Field">
        <field name="group_id" type="productgroup" label="COM_DHARMASHOP_PRODUCT_GROUP" description="COM_DHARMASHOP_PRODUCT_GROUP_DESC" />
        <field name="inherit_intro" type="list" label="COM_DHARMASHOP_INHERIT_INTRO" default="own" validate="options" showon="group_id!:0">
            <option value="own">COM_DHARMASHOP_INHERIT_OWN</option><option value="group">COM_DHARMASHOP_INHERIT_GROUP</option><option value="empty">COM_DHARMASHOP_INHERIT_EMPTY</option>
        </field>
        <field name="inherit_full" type="list" label="COM_DHARMASHOP_INHERIT_FULL" default="own" validate="options" showon="group_id!:0">
            <option value="own">COM_DHARMASHOP_INHERIT_OWN</option><option value="group">COM_DHARMASHOP_INHERIT_GROUP</option><option value="empty">COM_DHARMASHOP_INHERIT_EMPTY</option>
        </field>
        <field name="inherit_images" type="list" label="COM_DHARMASHOP_INHERIT_IMAGES" default="own" validate="options" showon="group_id!:0">
            <option value="own">COM_DHARMASHOP_INHERIT_OWN</option><option value="group">COM_DHARMASHOP_INHERIT_GROUP</option><option value="empty">COM_DHARMASHOP_INHERIT_EMPTY</option>
        </field>
    </fieldset>

	<fieldset name="media" addfieldprefix="Dharma\Component\DharmaShop\Administrator\Field">
		<field name="gallery" type="gallery" folder="products" filter="Dharma\Component\DharmaShop\Administrator\Image\ImageUploader::filterGallery" label="COM_DHARMASHOP_GALLERY_LABEL" description="COM_DHARMASHOP_GALLERY_DESC" />
	</fieldset>

	<fieldset name="price" addfieldprefix="Dharma\Component\DharmaShop\Administrator\Field">
		<field name="sku" type="text" label="COM_DHARMASHOP_FIELD_SKU_LABEL" description="COM_DHARMASHOP_FIELD_SKU_DESC" maxlength="100" />
		<field name="price" type="number" label="COM_DHARMASHOP_FIELD_PRICE_LABEL" description="COM_DHARMASHOP_FIELD_PRICE_DESC" step="0.01" min="0" hint="COM_DHARMASHOP_FIELD_PRICE_HINT" />
		<field name="price_zero_free" type="list" label="COM_DHARMASHOP_ORDER_PRICE_ZERO_FREE" description="COM_DHARMASHOP_ORDER_PRICE_ZERO_FREE_DESC" default="" validate="options">
			<option value="">COM_DHARMASHOP_ORDER_INHERIT</option>
			<option value="1">JYES</option>
			<option value="0">JNO</option>
		</field>
		<field name="discount" type="text" label="COM_DHARMASHOP_FIELD_DISCOUNT_LABEL" description="COM_DHARMASHOP_FIELD_DISCOUNT_DESC" hint="COM_DHARMASHOP_FIELD_DISCOUNT_HINT" maxlength="12" filter="string" />
		<field name="price_result" type="text" label="COM_DHARMASHOP_FIELD_PRICE_RESULT_LABEL" description="COM_DHARMASHOP_FIELD_PRICE_RESULT_DESC" class="readonly" readonly="true" filter="unset" showon="discount!:" />
		<field name="discount_start" type="calendar" label="COM_DHARMASHOP_FIELD_DISCOUNT_START_LABEL" translateformat="true" showtime="true" filter="user_utc" showon="discount!:" />
		<field name="discount_end" type="calendar" label="COM_DHARMASHOP_FIELD_DISCOUNT_END_LABEL" translateformat="true" showtime="true" filter="user_utc" showon="discount!:" />
		<field name="stock_qty" type="number" label="COM_DHARMASHOP_FIELD_STOCK_QTY_LABEL" description="COM_DHARMASHOP_FIELD_STOCK_QTY_DESC" step="0.001" default="0" showon="stock_tracked:1" />
		<field name="weight" type="number" label="COM_DHARMASHOP_FIELD_WEIGHT_LABEL" step="0.001" min="0" />
		<field name="weight_unit" type="unit" unitgroup="weight" validate="options" label="COM_DHARMASHOP_FIELD_WEIGHT_UNIT_LABEL" description="COM_DHARMASHOP_FIELD_WEIGHT_UNIT_DESC" />
		<field name="length" type="number" label="COM_DHARMASHOP_FIELD_LENGTH_LABEL" step="0.01" min="0" />
		<field name="width" type="number" label="COM_DHARMASHOP_FIELD_WIDTH_LABEL" step="0.01" min="0" />
		<field name="height" type="number" label="COM_DHARMASHOP_FIELD_HEIGHT_LABEL" step="0.01" min="0" />
		<field name="dimension_unit" type="unit" unitgroup="dimension" validate="options" label="COM_DHARMASHOP_FIELD_DIMENSION_UNIT_LABEL" description="COM_DHARMASHOP_FIELD_DIMENSION_UNIT_DESC" />
	</fieldset>

	<fieldset name="order_qty" addfieldprefix="Dharma\Component\DharmaShop\Administrator\Field">
		<field name="qty_min" type="number" label="COM_DHARMASHOP_ORDER_QTY_MIN" description="COM_DHARMASHOP_ORDER_QTY_MIN_DESC" step="0.001" min="0.001" />
		<field name="qty_step" type="number" label="COM_DHARMASHOP_ORDER_QTY_STEP" description="COM_DHARMASHOP_ORDER_QTY_STEP_DESC" step="0.001" min="0.001" />
		<field name="qty_max" type="number" label="COM_DHARMASHOP_ORDER_QTY_MAX" description="COM_DHARMASHOP_ORDER_QTY_MAX_DESC" step="0.001" min="0" />
		<field name="unit" type="unit" label="COM_DHARMASHOP_ORDER_UNIT" description="COM_DHARMASHOP_ORDER_UNIT_DESC" />
	</fieldset>

	<fieldset name="order_stock">
		<field name="stock_tracked" type="list" label="COM_DHARMASHOP_ORDER_STOCK_TRACKED" description="COM_DHARMASHOP_ORDER_STOCK_TRACKED_DESC" default="" validate="options">
			<option value="">COM_DHARMASHOP_ORDER_INHERIT</option>
			<option value="1">JYES</option>
			<option value="0">JNO</option>
		</field>
		<field name="backorder" type="list" label="COM_DHARMASHOP_ORDER_BACKORDER" description="COM_DHARMASHOP_ORDER_BACKORDER_DESC" default="" validate="options" showon="stock_tracked:1">
			<option value="">COM_DHARMASHOP_ORDER_INHERIT</option>
			<option value="1">JYES</option>
			<option value="0">JNO</option>
		</field>
	</fieldset>

	<fieldset name="category_order" addfieldprefix="Dharma\Component\DharmaShop\Administrator\Field">
		<field name="category_order" type="categoryorder" label="COM_DHARMASHOP_ORDER_CATEGORY_LABEL" description="COM_DHARMASHOP_ORDER_CATEGORY_DESC" hiddenLabel="true" filter="Dharma\Component\DharmaShop\Administrator\Support\FormFilters::categoryOrder" />
	</fieldset>

	<fieldset name="display" addfieldprefix="Dharma\Component\DharmaShop\Administrator\Field">
		<fields name="params">
			<field name="product_layout" type="layout" layoutgroup="product" label="COM_DHARMASHOP_LAYOUT_PRODUCT_LABEL" description="COM_DHARMASHOP_LAYOUT_PRODUCT_DESC" default="" validate="options">
				<option value="">COM_DHARMASHOP_LAYOUT_PRODUCT_INHERIT</option>
			</field>
		</fields>
	</fieldset>

	<fieldset name="publishing">
		<field name="created" type="calendar" label="JGLOBAL_FIELD_CREATED_LABEL" translateformat="true" showtime="true" filter="user_utc" />
		<field name="created_by" type="user" label="JGLOBAL_FIELD_CREATED_BY_LABEL" validate="UserId" />
		<field name="modified" type="calendar" label="JGLOBAL_FIELD_MODIFIED_LABEL" class="readonly" readonly="true" translateformat="true" showtime="true" filter="user_utc" />
		<field name="modified_by" type="user" label="JGLOBAL_FIELD_MODIFIED_BY_LABEL" class="readonly" readonly="true" filter="unset" validate="UserId" />
	</fieldset>

	<fieldset name="seo" addfieldprefix="Dharma\Component\DharmaShop\Administrator\Field">
		<fields name="params">
			<field name="meta_title" type="text" label="COM_DHARMASHOP_SEO_TITLE_LABEL" description="COM_DHARMASHOP_SEO_TITLE_DESC" maxlength="255" filter="string" />
		</fields>
		<field name="metadesc" type="textarea" label="COM_DHARMASHOP_SEO_DESCRIPTION_LABEL" description="COM_DHARMASHOP_SEO_DESCRIPTION_DESC" rows="3" maxlength="300" charcounter="true" />
		<fields name="params">
			<field name="meta_image" type="imageupload" filter="Dharma\Component\DharmaShop\Administrator\Image\ImageUploader::filterPath" folder="seo" label="COM_DHARMASHOP_SEO_IMAGE_LABEL" description="COM_DHARMASHOP_SEO_IMAGE_DESC" />
		</fields>
		<fields name="metadata">
			<field name="robots" type="list" label="COM_DHARMASHOP_SEO_ROBOTS_LABEL" validate="options">
				<option value="">COM_DHARMASHOP_SEO_ROBOTS_DEFAULT</option>
				<option value="index, follow">index, follow</option>
				<option value="noindex, follow">noindex, follow</option>
				<option value="index, nofollow">index, nofollow</option>
				<option value="noindex, nofollow">noindex, nofollow</option>
			</field>
		</fields>
		<fields name="params">
			<field name="breadcrumb_title" type="text" label="COM_DHARMASHOP_SEO_BREADCRUMB_LABEL" description="COM_DHARMASHOP_SEO_BREADCRUMB_DESC" maxlength="255" filter="string" />
			<field name="h1" type="text" label="COM_DHARMASHOP_SEO_H1_LABEL" description="COM_DHARMASHOP_SEO_H1_DESC" maxlength="255" filter="string" />
		</fields>
	</fieldset>

	<field name="rules" type="rules" label="JFIELD_RULES_LABEL" translate_label="false" filter="rules" component="com_dharmashop" section="product" validate="rules" />
</form>
