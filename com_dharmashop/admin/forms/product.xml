<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset name="basic" addfieldprefix="Joomla\Component\Categories\Administrator\Field">
		<field name="id" type="number" label="JGLOBAL_FIELD_ID_LABEL" default="0" class="readonly" readonly="true" />
		<field name="asset_id" type="hidden" filter="unset" />
		<field name="title" type="text" label="JGLOBAL_TITLE" required="true" maxlength="255" class="input-xxlarge input-large-text" size="40" />
		<field name="alias" type="text" label="JFIELD_ALIAS_LABEL" description="JFIELD_ALIAS_DESC" maxlength="190" hint="JFIELD_ALIAS_PLACEHOLDER" />
		<field name="catid" type="categoryedit" label="COM_DHARMASHOP_FIELD_CATEGORY_LABEL" description="COM_DHARMASHOP_FIELD_CATEGORY_DESC" extension="com_dharmashop" required="true" addfieldprefix="Joomla\Component\Categories\Administrator\Field" default="" />
		<field name="extra_catids" type="category" label="COM_DHARMASHOP_FIELD_EXTRA_CATEGORIES_LABEL" description="COM_DHARMASHOP_FIELD_EXTRA_CATEGORIES_DESC" extension="com_dharmashop" multiple="true" layout="joomla.form.field.list-fancy-select" />
		<field name="brand_id" type="category" label="COM_DHARMASHOP_FIELD_BRAND_LABEL" description="COM_DHARMASHOP_FIELD_BRAND_DESC" extension="com_dharmashop.brand">
			<option value="">COM_DHARMASHOP_FIELD_BRAND_NONE</option>
		</field>
		<field name="badge_ids" type="category" label="COM_DHARMASHOP_FIELD_BADGES_LABEL" description="COM_DHARMASHOP_FIELD_BADGES_DESC" extension="com_dharmashop.badge" multiple="true" layout="joomla.form.field.list-fancy-select" />
		<field name="state" type="list" label="JSTATUS" default="1" id="state" class="form-select-color-state" validate="options">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="2">JARCHIVED</option>
			<option value="-2">JTRASHED</option>
		</field>
		<field name="introtext" type="editor" label="COM_DHARMASHOP_FIELD_INTROTEXT_LABEL" description="COM_DHARMASHOP_FIELD_INTROTEXT_DESC" buttons="true" filter="\Joomla\CMS\Component\ComponentHelper::filterText" />
		<field name="fulltext" type="editor" label="COM_DHARMASHOP_FIELD_FULLTEXT_LABEL" buttons="true" filter="\Joomla\CMS\Component\ComponentHelper::filterText" />
		<field name="search_text" type="textarea" label="COM_DHARMASHOP_FIELD_SEARCH_TEXT_LABEL" description="COM_DHARMASHOP_FIELD_SEARCH_TEXT_DESC" rows="6" filter="string" />
	</fieldset>

	<fieldset name="media" addfieldprefix="Dharma\Component\DharmaShop\Administrator\Field">
		<field name="gallery" type="gallery" folder="products" filter="Dharma\Component\DharmaShop\Administrator\Image\ImageUploader::filterGallery" label="COM_DHARMASHOP_GALLERY_LABEL" description="COM_DHARMASHOP_GALLERY_DESC" />
	</fieldset>

	<fieldset name="price">
		<field name="sku" type="text" label="COM_DHARMASHOP_FIELD_SKU_LABEL" description="COM_DHARMASHOP_FIELD_SKU_DESC" maxlength="100" />
		<field name="price" type="number" label="COM_DHARMASHOP_FIELD_PRICE_LABEL" description="COM_DHARMASHOP_FIELD_PRICE_DESC" step="0.01" min="0" hint="COM_DHARMASHOP_FIELD_PRICE_HINT" />
		<field name="sale_price" type="number" label="COM_DHARMASHOP_FIELD_SALE_PRICE_LABEL" description="COM_DHARMASHOP_FIELD_SALE_PRICE_DESC" step="0.01" min="0" />
		<field name="sale_start" type="calendar" label="COM_DHARMASHOP_FIELD_SALE_START_LABEL" translateformat="true" showtime="true" filter="user_utc" showon="sale_price!:" />
		<field name="sale_end" type="calendar" label="COM_DHARMASHOP_FIELD_SALE_END_LABEL" translateformat="true" showtime="true" filter="user_utc" showon="sale_price!:" />
		<field name="stock_qty" type="number" label="COM_DHARMASHOP_FIELD_STOCK_QTY_LABEL" step="0.001" default="0" />
		<field name="weight" type="number" label="COM_DHARMASHOP_FIELD_WEIGHT_LABEL" step="0.001" min="0" />
		<field name="length" type="number" label="COM_DHARMASHOP_FIELD_LENGTH_LABEL" step="0.01" min="0" />
		<field name="width" type="number" label="COM_DHARMASHOP_FIELD_WIDTH_LABEL" step="0.01" min="0" />
		<field name="height" type="number" label="COM_DHARMASHOP_FIELD_HEIGHT_LABEL" step="0.01" min="0" />
	</fieldset>

	<fieldset name="order_qty">
		<field name="qty_min" type="number" label="COM_DHARMASHOP_ORDER_QTY_MIN" description="COM_DHARMASHOP_ORDER_QTY_MIN_DESC" step="0.001" min="0.001" />
		<field name="qty_step" type="number" label="COM_DHARMASHOP_ORDER_QTY_STEP" description="COM_DHARMASHOP_ORDER_QTY_STEP_DESC" step="0.001" min="0.001" />
		<field name="qty_max" type="number" label="COM_DHARMASHOP_ORDER_QTY_MAX" description="COM_DHARMASHOP_ORDER_QTY_MAX_DESC" step="0.001" min="0" />
		<field name="unit" type="text" label="COM_DHARMASHOP_ORDER_UNIT" description="COM_DHARMASHOP_ORDER_UNIT_DESC" maxlength="20" />
	</fieldset>

	<fieldset name="order_stock">
		<field name="stock_tracked" type="list" label="COM_DHARMASHOP_ORDER_STOCK_TRACKED" description="COM_DHARMASHOP_ORDER_STOCK_TRACKED_DESC" default="" validate="options">
			<option value="">COM_DHARMASHOP_ORDER_INHERIT</option>
			<option value="1">JYES</option>
			<option value="0">JNO</option>
		</field>
		<field name="backorder" type="list" label="COM_DHARMASHOP_ORDER_BACKORDER" description="COM_DHARMASHOP_ORDER_BACKORDER_DESC" default="" validate="options">
			<option value="">COM_DHARMASHOP_ORDER_INHERIT</option>
			<option value="1">JYES</option>
			<option value="0">JNO</option>
		</field>
	</fieldset>

	<fieldset name="publishing">
		<field name="created" type="calendar" label="JGLOBAL_FIELD_CREATED_LABEL" translateformat="true" showtime="true" filter="user_utc" />
		<field name="created_by" type="user" label="JGLOBAL_FIELD_CREATED_BY_LABEL" validate="UserId" />
		<field name="modified" type="calendar" label="JGLOBAL_FIELD_MODIFIED_LABEL" class="readonly" readonly="true" translateformat="true" showtime="true" filter="user_utc" />
		<field name="modified_by" type="user" label="JGLOBAL_FIELD_MODIFIED_BY_LABEL" class="readonly" readonly="true" filter="unset" validate="UserId" />
	</fieldset>

	<fieldset name="metadata" label="JGLOBAL_FIELDSET_METADATA_OPTIONS">
		<field name="metadesc" type="textarea" label="JFIELD_META_DESCRIPTION_LABEL" rows="3" maxlength="300" charcounter="true" />
		<field name="metakey" type="textarea" label="JFIELD_META_KEYWORDS_LABEL" rows="3" />
		<fields name="metadata">
			<field name="robots" type="list" label="JFIELD_METADATA_ROBOTS_LABEL" validate="options">
				<option value="">JGLOBAL_USE_GLOBAL</option>
				<option value="index, follow">index, follow</option>
				<option value="noindex, follow">noindex, follow</option>
				<option value="index, nofollow">index, nofollow</option>
				<option value="noindex, nofollow">noindex, nofollow</option>
			</field>
		</fields>
	</fieldset>

	<field name="rules" type="rules" label="JFIELD_RULES_LABEL" translate_label="false" filter="rules" component="com_dharmashop" section="product" validate="rules" />
</form>
