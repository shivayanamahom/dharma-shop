<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter">
		<field name="search" type="text" label="COM_DHARMASHOP_FILTER_SEARCH_LABEL" description="COM_DHARMASHOP_FILTER_SEARCH_DESC" hint="COM_DHARMASHOP_FILTER_SEARCH_HINT" />
		<field name="published" type="status" label="COM_DHARMASHOP_FILTER_STATE_LABEL" onchange="this.form.submit();">
			<option value="">COM_DHARMASHOP_FILTER_STATE_SELECT</option>
		</field>
		<field name="catid" type="category" label="COM_DHARMASHOP_FILTER_MAIN_CATEGORY_LABEL" extension="com_dharmashop" published="0,1,2" onchange="this.form.submit();">
			<option value="">COM_DHARMASHOP_FILTER_MAIN_CATEGORY_SELECT</option>
		</field>
		<field name="extra_catid" type="category" label="COM_DHARMASHOP_FILTER_EXTRA_CATEGORY_LABEL" extension="com_dharmashop" published="0,1,2" onchange="this.form.submit();">
			<option value="">COM_DHARMASHOP_FILTER_EXTRA_CATEGORY_SELECT</option>
		</field>
		<field name="brand_id" type="category" label="COM_DHARMASHOP_FILTER_BRAND_LABEL" extension="com_dharmashop.brand" published="0,1,2" onchange="this.form.submit();">
			<option value="">COM_DHARMASHOP_FILTER_BRAND_SELECT</option>
		</field>
		<field name="badge_id" type="category" label="COM_DHARMASHOP_FILTER_BADGE_LABEL" extension="com_dharmashop.badge" published="0,1,2" onchange="this.form.submit();">
			<option value="">COM_DHARMASHOP_FILTER_BADGE_SELECT</option>
		</field>
		<field name="category_id" type="category" label="COM_DHARMASHOP_FILTER_ALL_CATEGORIES_LABEL" extension="com_dharmashop" published="0,1,2" onchange="this.form.submit();">
			<option value="">COM_DHARMASHOP_FILTER_ALL_CATEGORIES_SELECT</option>
		</field>
		<field name="in_stock" type="list" label="COM_DHARMASHOP_FILTER_IN_STOCK_LABEL" onchange="this.form.submit();">
			<option value="">COM_DHARMASHOP_FILTER_IN_STOCK_SELECT</option>
			<option value="1">COM_DHARMASHOP_IN_STOCK</option>
			<option value="0">COM_DHARMASHOP_OUT_OF_STOCK</option>
		</field>
	</fields>
	<fields name="list">
		<field name="fullordering" type="list" label="JGLOBAL_SORT_BY" default="a.id DESC" onchange="this.form.submit();">
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.state ASC">JSTATUS_ASC</option>
			<option value="a.state DESC">JSTATUS_DESC</option>
			<option value="a.title ASC">JGLOBAL_TITLE_ASC</option>
			<option value="a.title DESC">JGLOBAL_TITLE_DESC</option>
			<option value="sku ASC">COM_DHARMASHOP_SORT_SKU_ASC</option>
			<option value="sku DESC">COM_DHARMASHOP_SORT_SKU_DESC</option>
			<option value="category_title ASC">COM_DHARMASHOP_SORT_CATEGORY_ASC</option>
			<option value="category_title DESC">COM_DHARMASHOP_SORT_CATEGORY_DESC</option>
			<option value="a.price_min ASC">COM_DHARMASHOP_SORT_PRICE_ASC</option>
			<option value="a.price_min DESC">COM_DHARMASHOP_SORT_PRICE_DESC</option>
			<option value="a.in_stock ASC">COM_DHARMASHOP_SORT_STOCK_ASC</option>
			<option value="a.in_stock DESC">COM_DHARMASHOP_SORT_STOCK_DESC</option>
			<option value="a.created ASC">JDATE_ASC</option>
			<option value="a.created DESC">JDATE_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>
		<field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="25" onchange="this.form.submit();" />
	</fields>
</form>
