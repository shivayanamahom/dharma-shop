<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Dharma\Component\DharmaShop\Administrator\Field">
    <fields name="filter">
        <field name="search" type="text" label="JSEARCH_FILTER" description="COM_DHARMASHOP_ORDERS_SEARCH" hint="JSEARCH_FILTER" />
        <field name="status_id" type="orderstatus" label="JSTATUS" onchange="this.form.submit();"><option value="">COM_DHARMASHOP_ORDER_ALL_STATUSES</option></field>
        <field name="customer_id" type="number" label="COM_DHARMASHOP_ORDER_CUSTOMER_ID" min="0" filter="integer" onchange="this.form.submit();" />
    </fields>
    <fields name="list">
        <field name="fullordering" type="list" label="JGLOBAL_SORT_BY" default="a.id DESC" onchange="this.form.submit();"><option value="a.id DESC">JGRID_HEADING_ID_DESC</option><option value="a.id ASC">JGRID_HEADING_ID_ASC</option><option value="a.created DESC">JDATE_DESC</option><option value="a.created ASC">JDATE_ASC</option><option value="a.total ASC">COM_DHARMASHOP_ORDER_TOTAL_ASC</option><option value="a.total DESC">COM_DHARMASHOP_ORDER_TOTAL_DESC</option></field>
        <field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="20" onchange="this.form.submit();" />
    </fields>
</form>
