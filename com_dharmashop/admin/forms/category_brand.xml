            <field name="brands_columns_sm" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS_SM" validate="options" showon="brands_breakpoints:1"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
            <field name="brands_columns_md" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS_MD" validate="options" showon="brands_breakpoints:1"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
            <field name="brands_columns_lg" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS_LG" validate="options" showon="brands_breakpoints:1"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
            <field name="brands_columns_xl" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS_XL" validate="options" showon="brands_breakpoints:1"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
            <field name="brands_columns_xxl" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS_XXL" validate="options" showon="brands_breakpoints:1"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
            <field name="brand_card_intro" label="COM_DHARMASHOP_DISPLAY_SHOW_INTRO" type="list" default="" validate="options"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="brand_card_count" label="COM_DHARMASHOP_DISPLAY_SHOW_COUNT" type="list" default="" validate="options" description="COM_DHARMASHOP_DISPLAY_SHOW_COUNT_DESC"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="brand_card_prices" label="COM_DHARMASHOP_DISPLAY_SHOW_PRICES" type="list" default="" validate="options" description="COM_DHARMASHOP_DISPLAY_SHOW_PRICES_DESC"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="0">JNO</option><option value="1">JYES</option></field>
		</fieldset>
	</fields>
</form>
