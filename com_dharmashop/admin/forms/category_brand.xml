<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="params">
		<fieldset name="dharmashop_brand" label="COM_DHARMASHOP_BRAND_FIELDSET_LABEL">
			<field name="brand_website" type="url" label="COM_DHARMASHOP_BRAND_WEBSITE_LABEL" description="COM_DHARMASHOP_BRAND_WEBSITE_DESC" validate="url" filter="url" relative="false" />
		</fieldset>
		<fieldset name="dharmashop_display_brands" label="COM_DHARMASHOP_CAT_DISPLAY_BRAND_LIST">
            <field name="brands_layout" type="layout" layoutgroup="brands" label="COM_DHARMASHOP_LAYOUT_BRANDS" default="" validate="options"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option></field>
            <field name="brand_card_layout" type="layout" layoutgroup="brand_card" label="COM_DHARMASHOP_LAYOUT_BRAND_CARD" default="" validate="options"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option></field>
