            <field name="brands_columns" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS" validate="options" showon="brands_breakpoints:0[OR]brands_breakpoints:" description="COM_DHARMASHOP_DISPLAY_COLUMNS_DESC"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
