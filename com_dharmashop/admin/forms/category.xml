<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset name="basic" addfieldprefix="Joomla\Component\Categories\Administrator\Field">
		<field name="id" type="number" label="JGLOBAL_FIELD_ID_LABEL" default="0" class="readonly" readonly="true" />
		<field name="asset_id" type="hidden" filter="unset" />
		<field name="extension" type="hidden" />
		<field name="title" type="text" label="JGLOBAL_TITLE" required="true" maxlength="255" class="input-xxlarge input-large-text" size="40" />
		<field name="alias" type="text" label="JFIELD_ALIAS_LABEL" description="JFIELD_ALIAS_DESC" maxlength="400" hint="JFIELD_ALIAS_PLACEHOLDER" />
		<field name="parent_id" type="categoryedit" label="COM_DHARMASHOP_FIELD_PARENT_LABEL" description="COM_DHARMASHOP_FIELD_PARENT_DESC" extension="com_dharmashop" parent="true" default="1" />
		<field name="published" type="list" label="JSTATUS" default="1" id="published" class="form-select-color-state" validate="options">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="2">JARCHIVED</option>
			<option value="-2">JTRASHED</option>
		</field>
		<field name="access" type="accesslevel" label="JFIELD_ACCESS_LABEL" filter="UINT" validate="options" />
		<field name="language" type="hidden" default="*" />
		<field name="description" type="editor" label="COM_DHARMASHOP_CAT_FULLTEXT_LABEL" description="COM_DHARMASHOP_CAT_FULLTEXT_DESC" buttons="true" filter="\Joomla\CMS\Component\ComponentHelper::filterText" />
		<field name="note" type="text" label="JFIELD_NOTE_LABEL" maxlength="255" />
	</fieldset>

	<fields name="params" addfieldprefix="Dharma\Component\DharmaShop\Administrator\Field">
		<fieldset name="dharmashop_media" label="COM_DHARMASHOP_CAT_FIELDSET_MEDIA">
			<field name="image" type="imageupload" filter="Dharma\Component\DharmaShop\Administrator\Image\ImageUploader::filterPath" folder="categories" label="COM_DHARMASHOP_CAT_IMAGE_LABEL" description="COM_DHARMASHOP_CAT_IMAGE_DESC" />
			<field name="image_alt" type="text" label="COM_DHARMASHOP_CAT_IMAGE_ALT_LABEL" />
			<field name="icon" type="imageupload" filter="Dharma\Component\DharmaShop\Administrator\Image\ImageUploader::filterPath" folder="icons" label="COM_DHARMASHOP_CAT_ICON_LABEL" description="COM_DHARMASHOP_CAT_ICON_DESC" />
		</fieldset>
		<fieldset name="dharmashop_text">
			<field name="introtext" type="editor" label="COM_DHARMASHOP_CAT_INTROTEXT_LABEL" description="COM_DHARMASHOP_CAT_INTROTEXT_DESC" buttons="true" filter="\Joomla\CMS\Component\ComponentHelper::filterText" />
		</fieldset>
		<fieldset name="dharmashop_order_qty">
			<field name="order_qty_min" type="number" label="COM_DHARMASHOP_ORDER_QTY_MIN" description="COM_DHARMASHOP_ORDER_QTY_MIN_DESC" step="0.001" min="0.001" />
			<field name="order_qty_step" type="number" label="COM_DHARMASHOP_ORDER_QTY_STEP" description="COM_DHARMASHOP_ORDER_QTY_STEP_DESC" step="0.001" min="0.001" />
			<field name="order_qty_max" type="number" label="COM_DHARMASHOP_ORDER_QTY_MAX" description="COM_DHARMASHOP_ORDER_QTY_MAX_DESC" step="0.001" min="0" />
			<field name="order_unit" type="unit" label="COM_DHARMASHOP_ORDER_UNIT" description="COM_DHARMASHOP_ORDER_UNIT_DESC" />
		</fieldset>
		<fieldset name="dharmashop_order_stock">
			<field name="order_stock_tracked" type="list" label="COM_DHARMASHOP_ORDER_STOCK_TRACKED" description="COM_DHARMASHOP_ORDER_STOCK_TRACKED_DESC" default="" validate="options">
				<option value="">COM_DHARMASHOP_ORDER_INHERIT</option>
				<option value="1">JYES</option>
				<option value="0">JNO</option>
			</field>
			<field name="order_price_zero_free" type="list" label="COM_DHARMASHOP_ORDER_PRICE_ZERO_FREE" description="COM_DHARMASHOP_ORDER_PRICE_ZERO_FREE_DESC" default="" validate="options">
				<option value="">COM_DHARMASHOP_ORDER_INHERIT</option>
				<option value="1">JYES</option>
				<option value="0">JNO</option>
			</field>
			<field name="order_backorder" type="list" label="COM_DHARMASHOP_ORDER_BACKORDER" description="COM_DHARMASHOP_ORDER_BACKORDER_DESC" default="" validate="options">
				<option value="">COM_DHARMASHOP_ORDER_INHERIT</option>
				<option value="1">JYES</option>
				<option value="0">JNO</option>
			</field>
		</fieldset>
		<fieldset name="dharmashop_display" label="COM_DHARMASHOP_DISPLAY_VISIBILITY">
            <field name="show_in_list" type="radio" label="COM_DHARMASHOP_CAT_SHOW_IN_LIST_LABEL" description="COM_DHARMASHOP_CAT_SHOW_IN_LIST_DESC" layout="joomla.form.field.radio.switcher" default="1">
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
		</fieldset>
		<fieldset name="dharmashop_display_children" label="COM_DHARMASHOP_CAT_DISPLAY_CATEGORY_LIST">
            <field name="categories_layout" type="layout" layoutgroup="categories" label="COM_DHARMASHOP_LAYOUT_CATEGORIES" default="" validate="options"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option></field>
            <field name="category_card_layout" type="layout" layoutgroup="category_card" label="COM_DHARMASHOP_LAYOUT_CATEGORY_CARD" default="" validate="options"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option></field>
            <field name="categories_breakpoints" label="COM_DHARMASHOP_DISPLAY_BREAKPOINTS" type="list" default="" validate="options" description="COM_DHARMASHOP_DISPLAY_BREAKPOINTS_DESC"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="categories_columns" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS" validate="options" showon="categories_breakpoints:0[OR]categories_breakpoints:" description="COM_DHARMASHOP_DISPLAY_COLUMNS_DESC"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
            <field name="categories_columns_xs" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS_XS" validate="options" showon="categories_breakpoints:1"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
            <field name="categories_columns_sm" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS_SM" validate="options" showon="categories_breakpoints:1"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
            <field name="categories_columns_md" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS_MD" validate="options" showon="categories_breakpoints:1"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
            <field name="categories_columns_lg" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS_LG" validate="options" showon="categories_breakpoints:1"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
            <field name="categories_columns_xl" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS_XL" validate="options" showon="categories_breakpoints:1"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
            <field name="categories_columns_xxl" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS_XXL" validate="options" showon="categories_breakpoints:1"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
            <field name="category_card_intro" label="COM_DHARMASHOP_DISPLAY_SHOW_INTRO" type="list" default="" validate="options"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="category_card_count" label="COM_DHARMASHOP_DISPLAY_SHOW_COUNT" type="list" default="" validate="options" description="COM_DHARMASHOP_DISPLAY_SHOW_COUNT_DESC"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="category_card_prices" label="COM_DHARMASHOP_DISPLAY_SHOW_PRICES" type="list" default="" validate="options" description="COM_DHARMASHOP_DISPLAY_SHOW_PRICES_DESC"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="0">JNO</option><option value="1">JYES</option></field>
		</fieldset>
        <fieldset name="dharmashop_display_products" label="COM_DHARMASHOP_DISPLAY_PRODUCTS">
            <field name="category_page_show_image" type="list" label="COM_DHARMASHOP_DISPLAY_CATEGORY_PAGE_IMAGE" description="COM_DHARMASHOP_DISPLAY_CATEGORY_PAGE_IMAGE_DESC" default="" validate="options"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="category_layout" type="layout" layoutgroup="category" label="COM_DHARMASHOP_DISPLAY_PRODUCT_PAGE_LAYOUT" description="COM_DHARMASHOP_LAYOUT_CATEGORY_DESC" default="" validate="options">
				<option value="">COM_DHARMASHOP_LAYOUT_INHERIT</option>
			</field>
            <field name="product_card_layout" type="layout" layoutgroup="product_card" label="COM_DHARMASHOP_LAYOUT_CARD_LABEL" description="COM_DHARMASHOP_LAYOUT_CARD_DESC" default="" validate="options">
				<option value="">COM_DHARMASHOP_LAYOUT_INHERIT</option>
			</field>
            <field name="category_default_view" type="list" label="COM_DHARMASHOP_DISPLAY_DEFAULT_PRODUCT_VIEW" description="COM_DHARMASHOP_DISPLAY_DEFAULT_PRODUCT_VIEW_DESC" default="" validate="options">
                <option value="">COM_DHARMASHOP_ORDER_INHERIT</option>
                <option value="grid">COM_DHARMASHOP_DISPLAY_VIEW_GRID</option>
                <option value="list">COM_DHARMASHOP_DISPLAY_VIEW_LIST</option>
                <option value="table">COM_DHARMASHOP_DISPLAY_VIEW_TABLE</option>
            </field>
            <field name="subcategory_show_image" type="list" label="COM_DHARMASHOP_DISPLAY_SUBCATEGORY_IMAGE" description="COM_DHARMASHOP_DISPLAY_SUBCATEGORY_IMAGE_DESC" default="" validate="options"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="category_breakpoints" label="COM_DHARMASHOP_DISPLAY_BREAKPOINTS" type="list" default="" validate="options" description="COM_DHARMASHOP_DISPLAY_BREAKPOINTS_DESC"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="category_columns" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS" validate="options" showon="category_breakpoints:0[OR]category_breakpoints:" description="COM_DHARMASHOP_DISPLAY_COLUMNS_DESC"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
            <field name="category_columns_xs" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS_XS" validate="options" showon="category_breakpoints:1"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
            <field name="category_columns_sm" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS_SM" validate="options" showon="category_breakpoints:1"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
            <field name="category_columns_md" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS_MD" validate="options" showon="category_breakpoints:1"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
            <field name="category_columns_lg" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS_LG" validate="options" showon="category_breakpoints:1"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
            <field name="category_columns_xl" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS_XL" validate="options" showon="category_breakpoints:1"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
            <field name="category_columns_xxl" type="list" label="COM_DHARMASHOP_DISPLAY_COLUMNS_XXL" validate="options" showon="category_breakpoints:1"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
            <field name="product_card_intro" label="COM_DHARMASHOP_DISPLAY_SHOW_INTRO" type="list" default="" validate="options"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="product_card_images" label="COM_DHARMASHOP_DISPLAY_CARD_IMAGES" description="COM_DHARMASHOP_DISPLAY_CARD_IMAGES_DESC" type="list" default="" validate="options"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="1">COM_DHARMASHOP_CARD_IMAGES_1</option><option value="2">COM_DHARMASHOP_CARD_IMAGES_2</option><option value="3">COM_DHARMASHOP_CARD_IMAGES_3</option><option value="4">COM_DHARMASHOP_CARD_IMAGES_4</option><option value="5">COM_DHARMASHOP_CARD_IMAGES_5</option><option value="0">COM_DHARMASHOP_CARD_IMAGES_ALL</option></field>
            <field name="product_card_cart_mode" label="COM_DHARMASHOP_CONFIG_CART_MODE_CARD" type="list" default="" validate="options"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="button">COM_DHARMASHOP_CART_MODE_BUTTON</option><option value="qty">COM_DHARMASHOP_CART_MODE_QTY</option><option value="stepper">COM_DHARMASHOP_CART_MODE_STEPPER</option></field>
            <field name="category_product_count" label="COM_DHARMASHOP_DISPLAY_SHOW_LIST_COUNT" type="list" default="" validate="options"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="category_price_range" label="COM_DHARMASHOP_DISPLAY_SHOW_LIST_PRICES" type="list" default="" validate="options"><option value="">COM_DHARMASHOP_ORDER_INHERIT</option><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="list_limit" type="number" label="COM_DHARMASHOP_CAT_LIST_LIMIT_LABEL" description="COM_DHARMASHOP_CAT_LIST_LIMIT_DESC" min="0" max="200" step="1" default="0" />
            <field name="list_ordering" type="list" label="COM_DHARMASHOP_CAT_LIST_ORDERING_LABEL" description="COM_DHARMASHOP_CAT_LIST_ORDERING_DESC" default="" validate="options">
				<option value="">COM_DHARMASHOP_CAT_ORDERING_GLOBAL</option>
				<option value="order">COM_DHARMASHOP_CAT_ORDERING_ORDER</option>
				<option value="price_asc">COM_DHARMASHOP_CAT_ORDERING_PRICE_ASC</option>
				<option value="price_desc">COM_DHARMASHOP_CAT_ORDERING_PRICE_DESC</option>
				<option value="new">COM_DHARMASHOP_CAT_ORDERING_NEW</option>
				<option value="title">COM_DHARMASHOP_CAT_ORDERING_TITLE</option>
			</field>
            <field name="new_product_position" type="list" label="COM_DHARMASHOP_CONFIG_NEW_PRODUCT_POSITION" description="COM_DHARMASHOP_NEW_PRODUCT_POSITION_INHERIT_DESC" default="" validate="options">
				<option value="">COM_DHARMASHOP_ORDER_INHERIT</option>
				<option value="first">COM_DHARMASHOP_ORDER_FIRST</option>
				<option value="last">COM_DHARMASHOP_ORDER_LAST</option>
			</field>
		</fieldset>
	</fields>

	<fieldset name="seo" addfieldprefix="Dharma\Component\DharmaShop\Administrator\Field">
		<fields name="params">
			<field name="meta_title" type="text" label="COM_DHARMASHOP_SEO_TITLE_LABEL" description="COM_DHARMASHOP_SEO_TITLE_DESC" maxlength="255" filter="string" />
		</fields>
		<field name="metadesc" type="textarea" label="COM_DHARMASHOP_SEO_DESCRIPTION_LABEL" description="COM_DHARMASHOP_SEO_DESCRIPTION_DESC" rows="3" maxlength="300" charcounter="true" />
		<fields name="params">
			<field name="meta_image" type="imageupload" filter="Dharma\Component\DharmaShop\Administrator\Image\ImageUploader::filterPath" folder="seo" label="COM_DHARMASHOP_SEO_IMAGE_LABEL" description="COM_DHARMASHOP_SEO_IMAGE_DESC" />
		</fields>
		<fields name="metadata">
			<field name="robots" type="list" label="COM_DHARMASHOP_SEO_ROBOTS_LABEL" validate="options">
				<option value="">COM_DHARMASHOP_SEO_ROBOTS_DEFAULT</option>
				<option value="index, follow">index, follow</option>
				<option value="noindex, follow">noindex, follow</option>
				<option value="index, nofollow">index, nofollow</option>
				<option value="noindex, nofollow">noindex, nofollow</option>
			</field>
		</fields>
		<fields name="params">
			<field name="breadcrumb_title" type="text" label="COM_DHARMASHOP_SEO_BREADCRUMB_LABEL" description="COM_DHARMASHOP_SEO_BREADCRUMB_DESC" maxlength="255" filter="string" />
			<field name="h1" type="text" label="COM_DHARMASHOP_SEO_H1_LABEL" description="COM_DHARMASHOP_SEO_H1_DESC" maxlength="255" filter="string" />
		</fields>
	</fieldset>

	<field name="rules" type="rules" label="JFIELD_RULES_LABEL" translate_label="false" filter="rules" component="com_dharmashop" section="category" validate="rules" />
</form>
