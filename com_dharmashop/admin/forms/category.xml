<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset name="basic" addfieldprefix="Joomla\Component\Categories\Administrator\Field">
		<field name="id" type="number" label="JGLOBAL_FIELD_ID_LABEL" default="0" class="readonly" readonly="true" />
		<field name="asset_id" type="hidden" filter="unset" />
		<field name="extension" type="hidden" />
		<field name="title" type="text" label="JGLOBAL_TITLE" required="true" maxlength="255" class="input-xxlarge input-large-text" size="40" />
		<field name="alias" type="text" label="JFIELD_ALIAS_LABEL" description="JFIELD_ALIAS_DESC" maxlength="400" hint="JFIELD_ALIAS_PLACEHOLDER" />
		<field name="parent_id" type="categoryedit" label="COM_DHARMASHOP_FIELD_PARENT_LABEL" description="COM_DHARMASHOP_FIELD_PARENT_DESC" extension="com_dharmashop" parent="true" default="1" />
		<field name="published" type="list" label="JSTATUS" default="1" id="published" class="form-select-color-state" validate="options">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="2">JARCHIVED</option>
			<option value="-2">JTRASHED</option>
		</field>
		<field name="access" type="accesslevel" label="JFIELD_ACCESS_LABEL" filter="UINT" validate="options" />
		<field name="language" type="hidden" default="*" />
		<field name="description" type="editor" label="JGLOBAL_DESCRIPTION" buttons="true" filter="\Joomla\CMS\Component\ComponentHelper::filterText" />
		<field name="note" type="text" label="JFIELD_NOTE_LABEL" maxlength="255" />
	</fieldset>

	<fields name="params">
		<fieldset name="dharmashop_image" label="COM_DHARMASHOP_CAT_FIELDSET_IMAGE">
			<field name="image" type="media" label="COM_DHARMASHOP_CAT_IMAGE_LABEL" description="COM_DHARMASHOP_CAT_IMAGE_DESC" types="images" />
			<field name="image_alt" type="text" label="COM_DHARMASHOP_CAT_IMAGE_ALT_LABEL" />
		</fieldset>
		<fieldset name="dharmashop_display" label="COM_DHARMASHOP_CAT_FIELDSET_DISPLAY">
			<field name="show_in_list" type="radio" label="COM_DHARMASHOP_CAT_SHOW_IN_LIST_LABEL" description="COM_DHARMASHOP_CAT_SHOW_IN_LIST_DESC" layout="joomla.form.field.radio.switcher" default="1">
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
			<field name="list_limit" type="number" label="COM_DHARMASHOP_CAT_LIST_LIMIT_LABEL" description="COM_DHARMASHOP_CAT_LIST_LIMIT_DESC" min="0" max="200" step="1" default="0" />
			<field name="list_ordering" type="list" label="COM_DHARMASHOP_CAT_LIST_ORDERING_LABEL" description="COM_DHARMASHOP_CAT_LIST_ORDERING_DESC" default="" validate="options">
				<option value="">COM_DHARMASHOP_CAT_ORDERING_GLOBAL</option>
				<option value="order">COM_DHARMASHOP_CAT_ORDERING_ORDER</option>
				<option value="price_asc">COM_DHARMASHOP_CAT_ORDERING_PRICE_ASC</option>
				<option value="price_desc">COM_DHARMASHOP_CAT_ORDERING_PRICE_DESC</option>
				<option value="new">COM_DHARMASHOP_CAT_ORDERING_NEW</option>
				<option value="title">COM_DHARMASHOP_CAT_ORDERING_TITLE</option>
			</field>
		</fieldset>
	</fields>

	<fieldset name="metadata">
		<field name="metadesc" type="textarea" label="JFIELD_META_DESCRIPTION_LABEL" rows="3" maxlength="300" charcounter="true" />
		<field name="metakey" type="textarea" label="JFIELD_META_KEYWORDS_LABEL" rows="3" />
		<fields name="metadata">
			<field name="robots" type="list" label="JFIELD_METADATA_ROBOTS_LABEL" validate="options">
				<option value="">JGLOBAL_USE_GLOBAL</option>
				<option value="index, follow">JGLOBAL_INDEX_FOLLOW</option>
				<option value="noindex, follow">JGLOBAL_NOINDEX_FOLLOW</option>
				<option value="index, nofollow">JGLOBAL_INDEX_NOFOLLOW</option>
				<option value="noindex, nofollow">JGLOBAL_NOINDEX_NOFOLLOW</option>
			</field>
		</fields>
	</fieldset>

	<field name="rules" type="rules" label="JFIELD_RULES_LABEL" translate_label="false" filter="rules" component="com_dharmashop" section="category" validate="rules" />
</form>
