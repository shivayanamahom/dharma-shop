<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Dharma\Component\DharmaShop\Administrator\Field">
    <fieldset name="details">
        <field name="id" type="hidden" filter="integer" />
        <field name="title" type="text" label="JGLOBAL_TITLE" required="true" maxlength="255" filter="string" class="input-large-text" />
        <field name="alias" type="text" label="JFIELD_ALIAS_LABEL" description="COM_DHARMASHOP_WAREHOUSE_ALIAS_DESC" maxlength="190" filter="string" />
        <field name="image" type="imageupload" filter="Dharma\Component\DharmaShop\Administrator\Image\ImageUploader::filterPath" folder="warehouses" label="COM_DHARMASHOP_WAREHOUSE_IMAGE" description="COM_DHARMASHOP_WAREHOUSE_IMAGE_DESC" />
        <field name="address" type="textarea" label="COM_DHARMASHOP_WAREHOUSE_ADDRESS" description="COM_DHARMASHOP_WAREHOUSE_ADDRESS_DESC" rows="2" maxlength="1000" filter="string" />
        <field name="coords" type="text" label="COM_DHARMASHOP_WAREHOUSE_COORDS" description="COM_DHARMASHOP_WAREHOUSE_COORDS_DESC" hint="[55.753994, 37.622093]" maxlength="60" filter="string" />
        <field name="phone" type="text" label="COM_DHARMASHOP_WAREHOUSE_PHONE" maxlength="100" filter="string" />
        <field name="email" type="text" label="COM_DHARMASHOP_WAREHOUSE_EMAIL" maxlength="190" filter="string" />
        <field name="hours" type="textarea" label="COM_DHARMASHOP_WAREHOUSE_HOURS" description="COM_DHARMASHOP_WAREHOUSE_HOURS_DESC" rows="2" maxlength="1000" filter="string" />
        <field name="info" type="textarea" label="COM_DHARMASHOP_WAREHOUSE_INFO" description="COM_DHARMASHOP_WAREHOUSE_INFO_DESC" rows="3" maxlength="2000" filter="string" />
        <field name="ready_term" type="text" label="COM_DHARMASHOP_WAREHOUSE_READY_TERM" description="COM_DHARMASHOP_WAREHOUSE_READY_TERM_DESC" maxlength="100" filter="string" />
    </fieldset>
    <fieldset name="publishing">
        <field name="state" type="list" label="JSTATUS" default="1" filter="integer" validate="options">
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
        </field>
        <field name="access" type="accesslevel" label="JFIELD_ACCESS_LABEL" default="1" filter="uint" />
        <field name="ordering" type="number" label="JFIELD_ORDERING_LABEL" default="0" min="0" filter="integer" />
    </fieldset>
</form>
