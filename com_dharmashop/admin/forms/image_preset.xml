<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Dharma\Component\DharmaShop\Administrator\Field">
    <field name="context" type="imagecontext" label="COM_DHARMASHOP_IMAGE_CONTEXT" required="true" filter="string" validate="options" />
    <field name="width" type="number" label="COM_DHARMASHOP_IMAGE_WIDTH" description="COM_DHARMASHOP_IMAGE_DIMENSION_DESC" default="400" min="0" max="2400" filter="integer" />
    <field name="height" type="number" label="COM_DHARMASHOP_IMAGE_HEIGHT" description="COM_DHARMASHOP_IMAGE_DIMENSION_DESC" default="400" min="0" max="2400" filter="integer" />
    <field name="mode" type="list" label="COM_DHARMASHOP_IMAGE_MODE" default="contain" validate="options"><option value="contain">COM_DHARMASHOP_IMAGE_CONTAIN</option><option value="cover">COM_DHARMASHOP_IMAGE_COVER</option><option value="stretch">COM_DHARMASHOP_IMAGE_STRETCH</option></field>
    <field name="format" type="list" label="COM_DHARMASHOP_IMAGE_FORMAT" default="auto" description="COM_DHARMASHOP_IMAGE_FORMAT_DESC" validate="options"><option value="auto">COM_DHARMASHOP_IMAGE_AUTO_FORMAT</option><option value="webp">WebP</option><option value="jpeg">JPEG</option><option value="png">PNG</option><option value="original">COM_DHARMASHOP_IMAGE_ORIGINAL_FORMAT</option></field>
</form>
