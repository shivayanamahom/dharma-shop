<?xml version="1.0" encoding="utf-8"?>
<!-- Страница корня раздела («Каталог», «Бренды»): те же поля, что у категории, но без дерева; хранится в настройках компонента (root_category, root_brand). -->
<form>
	<fieldset name="basic" addfieldprefix="Dharma\Component\DharmaShop\Administrator\Field">
		<field name="title" type="text" label="COM_DHARMASHOP_ROOT_TITLE_LABEL" description="COM_DHARMASHOP_ROOT_TITLE_DESC" maxlength="255" filter="string" class="input-xxlarge input-large-text" size="40" />
		<field name="description" type="editor" label="COM_DHARMASHOP_CAT_FULLTEXT_LABEL" description="COM_DHARMASHOP_CAT_FULLTEXT_DESC" buttons="true" filter="\Joomla\CMS\Component\ComponentHelper::filterText" />
		<fields name="params">
			<field name="image" type="imageupload" filter="Dharma\Component\DharmaShop\Administrator\Image\ImageUploader::filterPath" folder="categories" label="COM_DHARMASHOP_CAT_IMAGE_LABEL" description="COM_DHARMASHOP_CAT_IMAGE_DESC" />
			<field name="image_alt" type="text" label="COM_DHARMASHOP_CAT_IMAGE_ALT_LABEL" filter="string" />
			<field name="introtext" type="editor" label="COM_DHARMASHOP_CAT_INTROTEXT_LABEL" description="COM_DHARMASHOP_CAT_INTROTEXT_DESC" buttons="true" filter="\Joomla\CMS\Component\ComponentHelper::filterText" />
		</fields>
	</fieldset>

	<fieldset name="seo" addfieldprefix="Dharma\Component\DharmaShop\Administrator\Field">
		<fields name="params">
			<field name="meta_title" type="text" label="COM_DHARMASHOP_SEO_TITLE_LABEL" description="COM_DHARMASHOP_SEO_TITLE_DESC" maxlength="255" filter="string" />
		</fields>
		<field name="metadesc" type="textarea" label="COM_DHARMASHOP_SEO_DESCRIPTION_LABEL" description="COM_DHARMASHOP_SEO_DESCRIPTION_DESC" rows="3" maxlength="300" charcounter="true" />
		<fields name="params">
			<field name="meta_image" type="imageupload" filter="Dharma\Component\DharmaShop\Administrator\Image\ImageUploader::filterPath" folder="seo" label="COM_DHARMASHOP_SEO_IMAGE_LABEL" description="COM_DHARMASHOP_SEO_IMAGE_DESC" />
		</fields>
		<fields name="metadata">
			<field name="robots" type="list" label="COM_DHARMASHOP_SEO_ROBOTS_LABEL" validate="options">
				<option value="">COM_DHARMASHOP_SEO_ROBOTS_DEFAULT</option>
				<option value="index, follow">index, follow</option>
				<option value="noindex, follow">noindex, follow</option>
				<option value="index, nofollow">index, nofollow</option>
				<option value="noindex, nofollow">noindex, nofollow</option>
			</field>
		</fields>
		<fields name="params">
			<field name="breadcrumb_title" type="text" label="COM_DHARMASHOP_SEO_BREADCRUMB_LABEL" description="COM_DHARMASHOP_SEO_BREADCRUMB_DESC" maxlength="255" filter="string" />
			<field name="h1" type="text" label="COM_DHARMASHOP_SEO_H1_LABEL" description="COM_DHARMASHOP_SEO_H1_DESC" maxlength="255" filter="string" />
		</fields>
	</fieldset>
</form>
