<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Dharma\Component\DharmaShop\Administrator\Field">
 <field name="revision" type="hidden" filter="int" default="0"/>
 <fieldset name="details">
  <field name="title" type="text" label="JGLOBAL_TITLE" required="true" filter="string" maxlength="255"/>
  <field name="alias" type="text" label="JFIELD_ALIAS_LABEL" filter="string" maxlength="190"/>
  <field name="display_mode" type="list" label="COM_DHARMASHOP_GROUP_DISPLAY" description="COM_DHARMASHOP_GROUP_DISPLAY_PENDING" default="single" validate="options"><option value="single">COM_DHARMASHOP_GROUP_SINGLE</option><option value="all">COM_DHARMASHOP_GROUP_ALL</option></field>
  <field name="axes" type="choiceaxes" label="COM_DHARMASHOP_GROUP_AXES" description="COM_DHARMASHOP_GROUP_AXIS_INVALID" multiple="true" required="true" filter="int_array" layout="joomla.form.field.list-fancy-select"/>
  <field name="members" type="subform" validate="Subform" multiple="true" max="500" layout="joomla.form.field.subform.repeatable" label="COM_DHARMASHOP_GROUP_MEMBERS">
   <form><fieldset name="row" addfieldprefix="Dharma\Component\DharmaShop\Administrator\Field"><field name="product_id" type="modal_product" label="COM_DHARMASHOP_SELECT_A_PRODUCT" unique="true" filter="int" required="true"/></fieldset></form>
  </field>
  <field name="gallery" type="gallery" folder="products" label="COM_DHARMASHOP_GALLERY_LABEL" filter="Dharma\Component\DharmaShop\Administrator\Image\ImageUploader::filterGallery"/>
  <field name="introtext" type="editor" label="COM_DHARMASHOP_FIELD_INTROTEXT_LABEL" filter="\Joomla\CMS\Component\ComponentHelper::filterText"/>
  <field name="fulltext" type="editor" label="COM_DHARMASHOP_FIELD_FULLTEXT_LABEL" filter="\Joomla\CMS\Component\ComponentHelper::filterText"/>
 </fieldset>
 <fieldset name="publishing"><field name="id" type="number" label="JGLOBAL_FIELD_ID_LABEL" default="0" readonly="true" filter="int"/><field name="state" type="list" label="JSTATUS" default="1" validate="options"><option value="1">JPUBLISHED</option><option value="0">JUNPUBLISHED</option><option value="2">JARCHIVED</option><option value="-2">JTRASHED</option></field></fieldset>
 <fieldset name="generation"><field name="generation_catid" type="category" extension="com_dharmashop" label="COM_DHARMASHOP_FIELD_CATEGORY_LABEL"/></fieldset>
</form>
