{
	"$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
	"name": "com_dharmashop",
	"version": "0.1.0",
	"description": "Dharma Shop: ресурсы интерфейса",
	"license": "GPL-2.0-or-later",
	"assets": [
		{
			"name": "com_dharmashop.settings-search",
			"version": "ca7d6950f28e",
			"type": "script",
			"uri": "com_dharmashop/settings-search.js",
			"attributes": { "defer": true },
			"dependencies": ["core", "webcomponent.joomla-tab"]
		},
		{
			"name": "com_dharmashop.checkout",
			"version": "095cc928d07b",
			"type": "script",
			"uri": "com_dharmashop/checkout.js",
			"attributes": { "defer": true },
			"dependencies": ["core", "bootstrap.modal"]
		},
		{
			"name": "com_dharmashop.listing",
			"type": "script",
			"uri": "com_dharmashop/listing.js",
			"attributes": { "defer": true }
		},
		{
			"name": "com_dharmashop.pagination",
			"type": "script",
			"uri": "com_dharmashop/pagination.js",
			"attributes": { "defer": true },
			"dependencies": ["com_dharmashop.listing"]
		},
		{
			"name": "com_dharmashop.loadmore",
			"type": "script",
			"uri": "com_dharmashop/loadmore.js",
			"attributes": { "defer": true },
			"dependencies": ["core", "com_dharmashop.listing"]
		},
		{
			"name": "com_dharmashop.cart",
			"version": "e7eca6f5f8f9",
			"dependencies": ["core"],
			"type": "script",
			"uri": "com_dharmashop/cart.js",
			"attributes": { "defer": true }
		},
		{
			"name": "com_dharmashop.cart-toast",
			"version": "4650f42713b9",
			"type": "script",
			"uri": "com_dharmashop/cart-toast.js",
			"attributes": { "defer": true },
			"dependencies": ["com_dharmashop.cart", "bootstrap.toast"]
		},
		{
			"name": "com_dharmashop.card-slider",
			"type": "script",
			"uri": "com_dharmashop/card-slider.js",
			"attributes": { "defer": true }
		},
		{
			"name": "com_dharmashop.product-gallery",
			"type": "script",
			"uri": "com_dharmashop/product-gallery.js",
			"attributes": { "defer": true }
		},
		{
			"name": "com_dharmashop.cart-page",
			"type": "script",
			"uri": "com_dharmashop/cart-page.js",
			"attributes": { "defer": true },
			"dependencies": ["core"]
		},
		{
			"name": "com_dharmashop.mini-cart",
			"type": "script",
			"uri": "com_dharmashop/mini-cart.js",
			"attributes": { "defer": true },
			"dependencies": ["core"]
		},
		{
			"name": "com_dharmashop.qty",
			"type": "script",
			"uri": "com_dharmashop/qty.js",
			"attributes": { "defer": true }
		},
		{
			"name": "com_dharmashop.sale-countdown",
			"type": "script",
			"uri": "com_dharmashop/sale-countdown.js",
			"attributes": { "defer": true }
		},
		{
			"name": "com_dharmashop.uploader",
			"type": "script",
			"uri": "com_dharmashop/uploader.js",
			"attributes": { "defer": true },
			"dependencies": ["core"]
		},
		{
			"name": "com_dharmashop.uploader",
			"type": "style",
			"uri": "com_dharmashop/uploader.css"
		},
		{
			"name": "com_dharmashop.gallery",
			"type": "script",
			"uri": "com_dharmashop/gallery.js",
			"attributes": { "defer": true },
			"dependencies": ["core"]
		},
		{
			"name": "com_dharmashop.gallery",
			"type": "style",
			"uri": "com_dharmashop/gallery.css"
		}
	]
}
