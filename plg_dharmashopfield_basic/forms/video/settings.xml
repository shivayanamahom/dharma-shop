<?xml version="1.0" encoding="utf-8"?>
<form><fields name="params"><fieldset name="type_video" label="COM_DHARMASHOP_FIELD_TYPE_VIDEO">
    <field name="video_extensions" type="text" label="PLG_DHARMASHOPFIELD_BASIC_VIDEO_EXTENSIONS" description="PLG_DHARMASHOPFIELD_BASIC_VIDEO_EXTENSIONS_DESC" showon=".type:video" default="mp4,webm,ogv" filter="string" />
    <field name="video_max_count" type="number" label="PLG_DHARMASHOPFIELD_BASIC_VIDEO_MAX_COUNT" description="PLG_DHARMASHOPFIELD_BASIC_VIDEO_MAX_COUNT_DESC" showon=".type:video" default="20" min="1" max="100" step="1" filter="uint" />
    <field name="video_layout" type="list" label="PLG_DHARMASHOPFIELD_BASIC_VIDEO_LAYOUT" description="PLG_DHARMASHOPFIELD_BASIC_VIDEO_LAYOUT_DESC" showon=".type:video" default="grid" filter="cmd" validate="options"><option value="grid">PLG_DHARMASHOPFIELD_BASIC_VIDEO_LAYOUT_GRID</option><option value="slider">PLG_DHARMASHOPFIELD_BASIC_VIDEO_LAYOUT_SLIDER</option></field>
    <field name="video_columns_xs" type="list" label="PLG_DHARMASHOPFIELD_BASIC_VIDEO_COLUMNS_XS" showon=".type:video" default="1" filter="uint" validate="options"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
    <field name="video_columns_sm" type="list" label="PLG_DHARMASHOPFIELD_BASIC_VIDEO_COLUMNS_SM" showon=".type:video" default="1" filter="uint" validate="options"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
    <field name="video_columns_md" type="list" label="PLG_DHARMASHOPFIELD_BASIC_VIDEO_COLUMNS_MD" showon=".type:video" default="2" filter="uint" validate="options"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
    <field name="video_columns_lg" type="list" label="PLG_DHARMASHOPFIELD_BASIC_VIDEO_COLUMNS_LG" showon=".type:video" default="2" filter="uint" validate="options"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
    <field name="video_columns_xl" type="list" label="PLG_DHARMASHOPFIELD_BASIC_VIDEO_COLUMNS_XL" showon=".type:video" default="3" filter="uint" validate="options"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
    <field name="video_columns_xxl" type="list" label="PLG_DHARMASHOPFIELD_BASIC_VIDEO_COLUMNS_XXL" showon=".type:video" default="3" filter="uint" validate="options"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
    <field name="video_lightbox" type="radio" label="PLG_DHARMASHOPFIELD_BASIC_VIDEO_LIGHTBOX" description="PLG_DHARMASHOPFIELD_BASIC_VIDEO_LIGHTBOX_DESC" showon=".type:video" layout="joomla.form.field.radio.switcher" default="1" filter="int" validate="options"><option value="0">JNO</option><option value="1">JYES</option></field>
    <field name="video_caption" type="radio" label="PLG_DHARMASHOPFIELD_BASIC_VIDEO_CAPTION" description="PLG_DHARMASHOPFIELD_BASIC_VIDEO_CAPTION_DESC" showon=".type:video" layout="joomla.form.field.radio.switcher" default="1" filter="int" validate="options"><option value="0">JNO</option><option value="1">JYES</option></field>
    <field name="video_fetch_cover" type="radio" label="PLG_DHARMASHOPFIELD_BASIC_VIDEO_FETCH_COVER" description="PLG_DHARMASHOPFIELD_BASIC_VIDEO_FETCH_COVER_DESC" showon=".type:video" layout="joomla.form.field.radio.switcher" default="1" filter="int" validate="options"><option value="0">JNO</option><option value="1">JYES</option></field>
    <field name="video_folder" type="text" label="PLG_DHARMASHOPFIELD_BASIC_VIDEO_FOLDER" description="PLG_DHARMASHOPFIELD_BASIC_VIDEO_FOLDER_DESC" showon=".type:video" default="product" filter="string" maxlength="50" />
