    <field name="gallery_columns_xl" type="list" label="PLG_DHARMASHOPFIELD_BASIC_GALLERY_COLUMNS_XL" description="PLG_DHARMASHOPFIELD_BASIC_GALLERY_COLUMNS_XL_DESC" showon=".type:gallery" default="3" filter="uint" validate="options"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
