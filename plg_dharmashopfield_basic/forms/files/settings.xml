<?xml version="1.0" encoding="utf-8"?>
<form><fields name="params"><fieldset name="type_files" label="COM_DHARMASHOP_FIELD_TYPE_FILES">
    <field name="files_max_mb" type="number" label="PLG_DHARMASHOPFIELD_BASIC_FILES_MAX_MB" description="PLG_DHARMASHOPFIELD_BASIC_FILES_MAX_MB_DESC" showon=".type:files" default="10" min="0.1" max="1024" step="0.1" filter="float" />
    <field name="files_extensions" type="text" label="PLG_DHARMASHOPFIELD_BASIC_FILES_EXTENSIONS" description="PLG_DHARMASHOPFIELD_BASIC_FILES_EXTENSIONS_DESC" showon=".type:files" default="pdf,doc,docx,xls,xlsx,ppt,pptx,odt,ods,odp,rtf,txt,csv,zip,jpg,jpeg,png,webp" filter="string" />
    <field name="files_max_count" type="number" label="PLG_DHARMASHOPFIELD_BASIC_FILES_MAX_COUNT" description="PLG_DHARMASHOPFIELD_BASIC_FILES_MAX_COUNT_DESC" showon=".type:files" default="10" min="1" max="100" step="1" filter="uint" />
    <field name="files_label" type="list" label="PLG_DHARMASHOPFIELD_BASIC_FILES_LABEL" description="PLG_DHARMASHOPFIELD_BASIC_FILES_LABEL_DESC" showon=".type:files" default="caption" filter="cmd" validate="options"><option value="caption">PLG_DHARMASHOPFIELD_BASIC_FILES_CAPTION</option><option value="filename">PLG_DHARMASHOPFIELD_BASIC_FILES_FILENAME</option></field>
    <field name="files_show_size" type="radio" label="PLG_DHARMASHOPFIELD_BASIC_FILES_SHOW_SIZE" showon=".type:files" layout="joomla.form.field.radio.switcher" default="1" filter="int" validate="options"><option value="0">JNO</option><option value="1">JYES</option></field>
    <field name="files_show_extension" type="radio" label="PLG_DHARMASHOPFIELD_BASIC_FILES_SHOW_EXTENSION" showon=".type:files" layout="joomla.form.field.radio.switcher" default="1" filter="int" validate="options"><option value="0">JNO</option><option value="1">JYES</option></field>
    <field name="files_layout" type="list" label="PLG_DHARMASHOPFIELD_BASIC_FILES_LAYOUT" description="PLG_DHARMASHOPFIELD_BASIC_FILES_LAYOUT_DESC" showon=".type:files" default="list" filter="cmd" validate="options"><option value="list">PLG_DHARMASHOPFIELD_BASIC_FILES_LAYOUT_LIST</option><option value="grid">PLG_DHARMASHOPFIELD_BASIC_FILES_LAYOUT_GRID</option></field>
    <field name="files_columns" type="list" label="PLG_DHARMASHOPFIELD_BASIC_FILES_COLUMNS" description="PLG_DHARMASHOPFIELD_BASIC_FILES_COLUMNS_DESC" showon=".type:files[AND]files_layout:grid" default="3" filter="uint" validate="options"><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
    <field name="files_new_tab" type="radio" label="PLG_DHARMASHOPFIELD_BASIC_FILES_NEW_TAB" showon=".type:files" layout="joomla.form.field.radio.switcher" default="1" filter="int" validate="options"><option value="0">JNO</option><option value="1">JYES</option></field>
</fieldset></fields></form>
