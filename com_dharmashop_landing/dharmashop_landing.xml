<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="6.0" method="upgrade">
	<name>COM_DHARMASHOP_LANDING</name>
	<creationDate>2026-10</creationDate>
	<author>Dharma</author>
	<copyright>(C) 2026 Dharma. Все права защищены.</copyright>
	<license>GNU General Public License версии 2 или новее; см. LICENSE.txt</license>
	<version>0.1.14</version>
	<description>COM_DHARMASHOP_LANDING_XML_DESCRIPTION</description>
	<namespace path="src">Dharma\Component\DharmaShopLanding</namespace>

	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>

	<files folder="site">
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>

	<languages folder="site">
		<language tag="ru-RU">language/ru-RU/com_dharmashop_landing.ini</language>
		<language tag="en-GB">language/en-GB/com_dharmashop_landing.ini</language>
	</languages>

	<administration>
		<menu link="option=com_dharmashop_landing&amp;view=pages">COM_DHARMASHOP_LANDING_MENU</menu>
		<files folder="admin">
			<filename>access.xml</filename>
			<folder>forms</folder>
			<folder>language</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
		</files>
		<languages folder="admin">
			<language tag="en-GB">language/en-GB/com_dharmashop_landing.ini</language>
			<language tag="en-GB">language/en-GB/com_dharmashop_landing.sys.ini</language>
			<language tag="ru-RU">language/ru-RU/com_dharmashop_landing.ini</language>
			<language tag="ru-RU">language/ru-RU/com_dharmashop_landing.sys.ini</language>
		</languages>
	</administration>
