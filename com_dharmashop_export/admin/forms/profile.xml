<?xml version='1.0' encoding='UTF-8'?>
<form addfieldprefix="Dharma\Component\DharmaShopExport\Administrator\Field">
	<fieldset name="main" label="COM_DHARMASHOP_EXPORT_PROFILE">
		<field name="id" type="hidden" label="COM_DHARMASHOP_EXPORT_ID" default="0" />
		<field name="title" type="text" label="COM_DHARMASHOP_EXPORT_TITLE" required="true" maxlength="255" />
		<field name="state" type="list" label="COM_DHARMASHOP_EXPORT_STATE" default="1">
			<option value="1">JENABLED</option>
			<option value="0">JDISABLED</option>
		</field>
		<field name="entity" type="list" label="COM_DHARMASHOP_EXPORT_ENTITY" default="products">
			<option value="products">COM_DHARMASHOP_EXPORT_PRODUCTS</option>
			<option value="categories">COM_DHARMASHOP_EXPORT_CATEGORIES</option>
			<option value="brands">COM_DHARMASHOP_EXPORT_BRANDS</option>
			<option value="badges">COM_DHARMASHOP_EXPORT_BADGES</option>
			<option value="groups">COM_DHARMASHOP_EXPORT_GROUPS</option>
			<option value="fields">COM_DHARMASHOP_EXPORT_FIELDS</option>
			<option value="fieldgroups">COM_DHARMASHOP_EXPORT_FIELDGROUPS</option>
		</field>
		<field name="format" type="Format" label="COM_DHARMASHOP_EXPORT_FORMAT" default="csv" />
	</fieldset>
	<fields name="params">
		<fieldset name="filters" label="COM_DHARMASHOP_EXPORT_FILTERS">
			<field name="filter_state" type="list" label="COM_DHARMASHOP_EXPORT_FILTER_STATE" default="1">
				<option value="1">JPUBLISHED</option>
				<option value="0">JUNPUBLISHED</option>
				<option value="*">JALL</option>
			</field>
			<field name="categories" type="sql" label="COM_DHARMASHOP_EXPORT_CATEGORIES" query="SELECT id AS value, title AS text FROM #__categories WHERE extension='com_dharmashop' AND parent_id&gt;0 ORDER BY lft" key_field="value" value_field="text" multiple="true" layout="joomla.form.field.list-fancy-select" showon=".entity:products,groups" />
			<field name="in_stock" type="list" label="COM_DHARMASHOP_EXPORT_IN_STOCK" default="0" showon=".entity:products,groups">
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
		</fieldset>
		<fieldset name="columns" label="COM_DHARMASHOP_EXPORT_COLUMNS">
			<field name="column_help" type="note" label="COM_DHARMASHOP_EXPORT_COLUMN_HELP" description="COM_DHARMASHOP_EXPORT_COLUMN_HELP_DESC" class="alert alert-info" />
			<field name="columns_products" type="subform" label="COM_DHARMASHOP_EXPORT_COLUMNS" multiple="true" max="200" buttons="add,remove,move" layout="export.subform.columns" layoutIncludePath="administrator/components/com_dharmashop_export/layouts" showon=".entity:products">
				<form addfieldprefix="Dharma\Component\DharmaShopExport\Administrator\Field">
					<field name="key" type="Column" label="COM_DHARMASHOP_EXPORT_KEY" layout="joomla.form.field.list-fancy-select" entity="products" />
					<field name="header" type="text" label="COM_DHARMASHOP_EXPORT_HEADER" maxlength="255" />
					<field name="mode" type="list" label="COM_DHARMASHOP_EXPORT_MODE">
						<option value="">COM_DHARMASHOP_EXPORT_MODE_ORIGINAL</option>
						<option value="plain">COM_DHARMASHOP_EXPORT_MODE_PLAIN</option>
						<option value="yesno">COM_DHARMASHOP_EXPORT_MODE_YESNO</option>
						<option value="emptyzero">COM_DHARMASHOP_EXPORT_MODE_EMPTYZERO</option>
					</field>
				</form>
			</field>
			<field name="columns_categories" type="subform" label="COM_DHARMASHOP_EXPORT_COLUMNS" multiple="true" max="200" buttons="add,remove,move" layout="export.subform.columns" layoutIncludePath="administrator/components/com_dharmashop_export/layouts" showon=".entity:categories">
				<form addfieldprefix="Dharma\Component\DharmaShopExport\Administrator\Field">
					<field name="key" type="Column" label="COM_DHARMASHOP_EXPORT_KEY" layout="joomla.form.field.list-fancy-select" entity="categories" />
					<field name="header" type="text" label="COM_DHARMASHOP_EXPORT_HEADER" maxlength="255" />
					<field name="mode" type="list" label="COM_DHARMASHOP_EXPORT_MODE">
						<option value="">COM_DHARMASHOP_EXPORT_MODE_ORIGINAL</option>
						<option value="plain">COM_DHARMASHOP_EXPORT_MODE_PLAIN</option>
						<option value="yesno">COM_DHARMASHOP_EXPORT_MODE_YESNO</option>
						<option value="emptyzero">COM_DHARMASHOP_EXPORT_MODE_EMPTYZERO</option>
					</field>
				</form>
			</field>
			<field name="columns_brands" type="subform" label="COM_DHARMASHOP_EXPORT_COLUMNS" multiple="true" max="200" buttons="add,remove,move" layout="export.subform.columns" layoutIncludePath="administrator/components/com_dharmashop_export/layouts" showon=".entity:brands">
				<form addfieldprefix="Dharma\Component\DharmaShopExport\Administrator\Field">
					<field name="key" type="Column" label="COM_DHARMASHOP_EXPORT_KEY" layout="joomla.form.field.list-fancy-select" entity="brands" />
					<field name="header" type="text" label="COM_DHARMASHOP_EXPORT_HEADER" maxlength="255" />
					<field name="mode" type="list" label="COM_DHARMASHOP_EXPORT_MODE">
						<option value="">COM_DHARMASHOP_EXPORT_MODE_ORIGINAL</option>
						<option value="plain">COM_DHARMASHOP_EXPORT_MODE_PLAIN</option>
						<option value="yesno">COM_DHARMASHOP_EXPORT_MODE_YESNO</option>
						<option value="emptyzero">COM_DHARMASHOP_EXPORT_MODE_EMPTYZERO</option>
					</field>
				</form>
			</field>
			<field name="columns_badges" type="subform" label="COM_DHARMASHOP_EXPORT_COLUMNS" multiple="true" max="200" buttons="add,remove,move" layout="export.subform.columns" layoutIncludePath="administrator/components/com_dharmashop_export/layouts" showon=".entity:badges">
				<form addfieldprefix="Dharma\Component\DharmaShopExport\Administrator\Field">
					<field name="key" type="Column" label="COM_DHARMASHOP_EXPORT_KEY" layout="joomla.form.field.list-fancy-select" entity="badges" />
					<field name="header" type="text" label="COM_DHARMASHOP_EXPORT_HEADER" maxlength="255" />
					<field name="mode" type="list" label="COM_DHARMASHOP_EXPORT_MODE">
						<option value="">COM_DHARMASHOP_EXPORT_MODE_ORIGINAL</option>
						<option value="plain">COM_DHARMASHOP_EXPORT_MODE_PLAIN</option>
						<option value="yesno">COM_DHARMASHOP_EXPORT_MODE_YESNO</option>
						<option value="emptyzero">COM_DHARMASHOP_EXPORT_MODE_EMPTYZERO</option>
					</field>
				</form>
			</field>
			<field name="columns_groups" type="subform" label="COM_DHARMASHOP_EXPORT_COLUMNS" multiple="true" max="200" buttons="add,remove,move" layout="export.subform.columns" layoutIncludePath="administrator/components/com_dharmashop_export/layouts" showon=".entity:groups">
				<form addfieldprefix="Dharma\Component\DharmaShopExport\Administrator\Field">
					<field name="key" type="Column" label="COM_DHARMASHOP_EXPORT_KEY" layout="joomla.form.field.list-fancy-select" entity="groups" />
					<field name="header" type="text" label="COM_DHARMASHOP_EXPORT_HEADER" maxlength="255" />
					<field name="mode" type="list" label="COM_DHARMASHOP_EXPORT_MODE">
						<option value="">COM_DHARMASHOP_EXPORT_MODE_ORIGINAL</option>
						<option value="plain">COM_DHARMASHOP_EXPORT_MODE_PLAIN</option>
						<option value="yesno">COM_DHARMASHOP_EXPORT_MODE_YESNO</option>
						<option value="emptyzero">COM_DHARMASHOP_EXPORT_MODE_EMPTYZERO</option>
					</field>
				</form>
			</field>
			<field name="columns_fields" type="subform" label="COM_DHARMASHOP_EXPORT_COLUMNS" multiple="true" max="200" buttons="add,remove,move" layout="export.subform.columns" layoutIncludePath="administrator/components/com_dharmashop_export/layouts" showon=".entity:fields">
				<form addfieldprefix="Dharma\Component\DharmaShopExport\Administrator\Field">
					<field name="key" type="Column" label="COM_DHARMASHOP_EXPORT_KEY" layout="joomla.form.field.list-fancy-select" entity="fields" />
					<field name="header" type="text" label="COM_DHARMASHOP_EXPORT_HEADER" maxlength="255" />
					<field name="mode" type="list" label="COM_DHARMASHOP_EXPORT_MODE">
						<option value="">COM_DHARMASHOP_EXPORT_MODE_ORIGINAL</option>
						<option value="plain">COM_DHARMASHOP_EXPORT_MODE_PLAIN</option>
						<option value="yesno">COM_DHARMASHOP_EXPORT_MODE_YESNO</option>
						<option value="emptyzero">COM_DHARMASHOP_EXPORT_MODE_EMPTYZERO</option>
					</field>
				</form>
			</field>
			<field name="columns_fieldgroups" type="subform" label="COM_DHARMASHOP_EXPORT_COLUMNS" multiple="true" max="200" buttons="add,remove,move" layout="export.subform.columns" layoutIncludePath="administrator/components/com_dharmashop_export/layouts" showon=".entity:fieldgroups">
				<form addfieldprefix="Dharma\Component\DharmaShopExport\Administrator\Field">
					<field name="key" type="Column" label="COM_DHARMASHOP_EXPORT_KEY" layout="joomla.form.field.list-fancy-select" entity="fieldgroups" />
					<field name="header" type="text" label="COM_DHARMASHOP_EXPORT_HEADER" maxlength="255" />
					<field name="mode" type="list" label="COM_DHARMASHOP_EXPORT_MODE">
						<option value="">COM_DHARMASHOP_EXPORT_MODE_ORIGINAL</option>
						<option value="plain">COM_DHARMASHOP_EXPORT_MODE_PLAIN</option>
						<option value="yesno">COM_DHARMASHOP_EXPORT_MODE_YESNO</option>
						<option value="emptyzero">COM_DHARMASHOP_EXPORT_MODE_EMPTYZERO</option>
					</field>
				</form>
			</field>
		</fieldset>
		<fieldset name="output" label="COM_DHARMASHOP_EXPORT_OUTPUT">
			<field name="file_name" type="text" label="COM_DHARMASHOP_EXPORT_FILE_NAME" default="catalog" maxlength="80" description="COM_DHARMASHOP_EXPORT_FILE_NAME_DESC" />
			<field name="visibility" type="list" label="COM_DHARMASHOP_EXPORT_VISIBILITY" default="private" showon=".format!:yml">
				<option value="private">COM_DHARMASHOP_EXPORT_PRIVATE</option>
				<option value="public">COM_DHARMASHOP_EXPORT_PUBLIC</option>
			</field>
			<field name="site_url" type="text" label="COM_DHARMASHOP_EXPORT_SITE_URL" required="true" hint="https://example.ru" description="COM_DHARMASHOP_EXPORT_SITE_URL_DESC" />
			<field name="sef_urls" type="list" label="COM_DHARMASHOP_EXPORT_SEF_URLS" description="COM_DHARMASHOP_EXPORT_SEF_URLS_DESC" default="1">
				<option value="1">JYES</option>
				<option value="0">JNO</option>
			</field>
			<field name="list_separator" type="text" label="COM_DHARMASHOP_EXPORT_LIST_SEPARATOR" default=" | " maxlength="20" />
		</fieldset>
		<fieldset name="csv" label="COM_DHARMASHOP_EXPORT_CSV">
			<field name="csv_separator" type="list" label="COM_DHARMASHOP_EXPORT_CSV_SEPARATOR" default=";" showon=".format:csv">
				<option value=";">;</option>
				<option value=",">,</option>
				<option value="tab">TAB</option>
			</field>
			<field name="csv_bom" type="list" label="COM_DHARMASHOP_EXPORT_CSV_BOM" default="1" showon=".format:csv">
				<option value="1">JYES</option>
				<option value="0">JNO</option>
			</field>
		</fieldset>
	</fields>
</form>