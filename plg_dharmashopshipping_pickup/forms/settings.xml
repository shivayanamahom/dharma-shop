        <option value="16x9">PLG_DHARMASHOPSHIPPING_PICKUP_RATIO_16X9</option>
        <option value="4x3">PLG_DHARMASHOPSHIPPING_PICKUP_RATIO_4X3</option>
        <option value="1x1">PLG_DHARMASHOPSHIPPING_PICKUP_RATIO_1X1</option>
