    <field name="max_total" type="text" label="PLG_DHARMASHOPSHIPPING_PICKUP_MAX_TOTAL" description="PLG_DHARMASHOPSHIPPING_PICKUP_MAX_TOTAL_DESC" showon=".plugin:pickup" default="0" filter="string" />
