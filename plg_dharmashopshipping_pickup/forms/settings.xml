    <field name="zoom" type="number" label="PLG_DHARMASHOPSHIPPING_PICKUP_ZOOM" description="PLG_DHARMASHOPSHIPPING_PICKUP_ZOOM_DESC" showon=".plugin:pickup[AND]map:yandex" default="0" min="0" max="19" filter="integer" />
    <field name="zoom_selected" type="number" label="PLG_DHARMASHOPSHIPPING_PICKUP_ZOOM_SELECTED" description="PLG_DHARMASHOPSHIPPING_PICKUP_ZOOM_SELECTED_DESC" showon=".plugin:pickup[AND]map:yandex" default="15" min="0" max="19" filter="integer" />
    <field name="map_ratio" type="list" label="PLG_DHARMASHOPSHIPPING_PICKUP_RATIO" description="PLG_DHARMASHOPSHIPPING_PICKUP_RATIO_DESC" showon=".plugin:pickup[AND]map:yandex" default="16x9" filter="cmd" validate="options">
