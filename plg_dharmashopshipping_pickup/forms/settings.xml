<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Dharma\Component\DharmaShop\Administrator\Field"><fields name="params"><fields name="pickup"><fieldset name="type_pickup" label="PLG_DHARMASHOPSHIPPING_PICKUP_SETTINGS">
